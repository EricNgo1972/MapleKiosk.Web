@page "/shop/success"
@rendermode InteractiveServer
@inject CartState Cart
@inject MapleShopClient Client

<PageTitle>Order confirmed — MapleKiosk</PageTitle>

<section class="mshop-result">
    <div class="mshop-result__card">
        <div class="mshop-result__icon">✓</div>
        <h1>Thank you for your purchase</h1>
        @if (!string.IsNullOrWhiteSpace(Ref))
        {
            <p>Your order reference is <code>@Ref</code>.</p>
            @if (_status is not null && string.Equals(_status.Status, "Paid", StringComparison.OrdinalIgnoreCase))
            {
                <p class="mshop-result__ok">Payment confirmed. A receipt is on its way to your inbox.</p>
                @if (_status.IsSubscription)
                {
                    <p>
                        @(_status.TrialDays > 0 ? $"Your {_status.TrialDays}-day free trial has started. " : "")
                        Your plan renews automatically every @(_status.Interval == "Yearly" ? "year" : "month") on the same card — cancel any time.
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_status.ManageUrl))
                    {
                        <p><a href="@_status.ManageUrl" target="_blank" rel="noopener">Manage your subscription</a></p>
                    }
                }
            }
            else
            {
                <p class="mshop-result__pending">We're finalizing your payment confirmation…</p>
            }
        }
        else
        {
            <p>Your order is complete.</p>
        }
        <a class="mshop-btn mshop-btn--primary" href="/">Back to home</a>
    </div>
</section>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "ref")]
    public string? Ref { get; set; }

    private OrderStatus? _status;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Paid (or being confirmed): empty the cart, here and in browser storage.
        await Cart.RestoreAsync();
        Cart.Clear();

        // Stripe redirects here on success, but the webhook is what flips the order to Paid,
        // so give it a few seconds to land.
        if (string.IsNullOrWhiteSpace(Ref)) return;
        for (var attempt = 0; attempt < 5; attempt++)
        {
            _status = await Client.GetStatusAsync(Ref!);
            if (string.Equals(_status?.Status, "Paid", StringComparison.OrdinalIgnoreCase)) break;
            await Task.Delay(TimeSpan.FromSeconds(2));
        }
        StateHasChanged();
    }
}

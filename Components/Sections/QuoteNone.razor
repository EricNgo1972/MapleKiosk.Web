@inject LocalizationService L

@* "Not now" for one of the quote builder's radio groups (NailsPricing): picked by default, so a
   group adds nothing to the bill until the visitor chooses a plan, and they can take one back out. *@
<label class="pr-none">
    <input type="radio" name="@Group" value="" checked />
    <span>@L["pr.none"]</span>
</label>

@code {
    [Parameter, EditorRequired] public string Group { get; set; } = "";
}

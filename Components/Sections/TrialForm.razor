@* Static form (no Blazor circuit): marketing pages stay plain HTML, so the "Book a demo" modal
   opens instantly instead of waiting on a WebSocket through the tunnel. Posts as an enhanced form. *@
@inject TrialSignupService Signups
@inject LocalizationService L
@inject NavigationManager Nav

<div class="modal @(_reopen ? "open" : "")" id="trialModal" role="dialog" aria-modal="true" aria-labelledby="trial-title">
    <div class="modal__backdrop" data-close-trial></div>
    <div class="modal__dialog">
        <button type="button" class="modal__close" aria-label="Close" data-close-trial>&times;</button>
        <div class="trial__intro">
            <span class="eyebrow">@L["trial.eyebrow"]</span>
            <h2 id="trial-title">@L["trial.title"]</h2>
            <p>@L["trial.sub"]</p>
        </div>

        <div class="trial__card">
            <EditForm Model="Model" OnValidSubmit="HandleSubmit" OnInvalidSubmit="() => _reopen = true" FormName="trial-signup" Enhance>
                <DataAnnotationsValidator />

                <div class="field">
                    <label>@L["trial.f.company"]</label>
                    <InputText @bind-Value="Model.CompanyName" placeholder="@L["trial.f.ph.company"]" />
                    <ValidationMessage For="() => Model.CompanyName" />
                </div>

                <div class="field">
                    <label>@L["trial.f.address"]</label>
                    <InputText @bind-Value="Model.Address" placeholder="@L["trial.f.ph.address"]" />
                    <ValidationMessage For="() => Model.Address" />
                </div>

                <div class="field-row">
                    <div class="field">
                        <label>@L["trial.f.city"]</label>
                        <InputText @bind-Value="Model.City" placeholder="@L["trial.f.ph.city"]" />
                        <ValidationMessage For="() => Model.City" />
                    </div>
                    <div class="field">
                        <label>@L["trial.f.postal"]</label>
                        <InputText @bind-Value="Model.PostalCode" placeholder="@L["trial.f.ph.postal"]" />
                        <ValidationMessage For="() => Model.PostalCode" />
                    </div>
                </div>

                <div class="field">
                    <label>@L["trial.f.biztype"]</label>
                    <InputSelect @bind-Value="Model.BusinessType">
                        <option value="">@L["trial.f.biztype.select"]</option>
                        <option value="Nail Salon">@L["trial.f.biztype.nail"]</option>
                        <option value="Restaurant">@L["trial.f.biztype.resto"]</option>
                        <option value="Retail">@L["trial.f.biztype.retail"]</option>
                        <option value="Garage">@L["trial.f.biztype.garage"]</option>
                        <option value="Startup">@L["trial.f.biztype.startup"]</option>
                        <option value="Other">@L["trial.f.biztype.other"]</option>
                    </InputSelect>
                    <ValidationMessage For="() => Model.BusinessType" />
                </div>

                <div class="field-row field-row--3">
                    <div class="field">
                        <label>@L["trial.f.contact"]</label>
                        <InputText @bind-Value="Model.ContactName" placeholder="@L["trial.f.ph.contact"]" />
                        <ValidationMessage For="() => Model.ContactName" />
                    </div>
                    <div class="field">
                        <label>@L["trial.f.email"]</label>
                        <InputText type="email" @bind-Value="Model.Email" placeholder="@L["trial.f.ph.email"]" />
                        <ValidationMessage For="() => Model.Email" />
                    </div>
                    <div class="field">
                        <label>@L["trial.f.phone"]</label>
                        <InputText type="tel" @bind-Value="Model.Phone" placeholder="@L["trial.f.ph.phone"]" />
                        <ValidationMessage For="() => Model.Phone" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary trial__submit" data-busy-label="@L["trial.submitting"]">@L["trial.submit"]</button>
                <p class="trial__fine">@L["trial.fine"]</p>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Culture { get; set; } = "en";

    [SupplyParameterFromForm(FormName = "trial-signup")]
    private TrialSignup? Model { get; set; }

    // A post that failed validation re-renders the page — keep the modal open to show the errors.
    private bool _reopen;

    protected override void OnInitialized() => Model ??= new();

    protected override void OnParametersSet()
    {
        L.SetCulture(Culture);
        ValidationCulture.Current.Value = L.Culture;
    }

    private async Task HandleSubmit()
    {
        Model!.Culture = L.Culture;
        await Signups.CreateAsync(Model);
        var root = L.Path(L.Culture).TrimEnd('/');
        Nav.NavigateTo(string.IsNullOrEmpty(root) ? "/thank-you" : $"{root}/thank-you");
    }
}

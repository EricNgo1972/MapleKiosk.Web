@inject LocalizationService L

<section class="section section--surface fade-in" id="faq">
    <div class="container">
        <div class="lp-band__head lp-band__head--center">
            <span class="eyebrow">@L["faq.eyebrow"]</span>
            <h2>@L["faq.title"]</h2>
        </div>
        <div class="faq">
            @for (var i = 1; i <= 5; i++)
            {
                var n = i;
                <details class="faq__item">
                    <summary>@L[$"faq.{n}.q"]</summary>
                    <p>@L[$"faq.{n}.a"]</p>
                </details>
            }
        </div>
    </div>
</section>
<script type="application/ld+json">@((MarkupString)Json())</script>

@code {
    private string Json()
    {
        var items = new List<object>();
        for (var i = 1; i <= 5; i++)
        {
            items.Add(new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = L[$"faq.{i}.q"],
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = L[$"faq.{i}.a"]
                }
            });
        }
        return System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = items
        });
    }
}

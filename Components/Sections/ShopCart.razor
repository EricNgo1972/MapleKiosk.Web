@rendermode InteractiveServer
@implements IDisposable
@using MapleShop.UI.Services
@inject CartState Cart
@inject MapleShopClient Client
@inject LocalizationService L
@inject NavigationManager Nav

@* The shop's cart, beside the products (below them on phones, with a bar at the bottom of the screen).
   Checkout sends only SKUs and quantities; the server prices them from the catalog and opens Stripe:
   one-time items are charged once, plans become one subscription that Stripe renews. *@

<aside class="sh-cart" id="cart" aria-labelledby="shop-cart-title">
    <h2 class="sh-cart__title" id="shop-cart-title">@L["cart.title"]</h2>

    @if (Cart.Lines.Count == 0)
    {
        <p class="shop-cart__empty">@L["cart.empty"]</p>
    }
    else
    {
        <ul class="shop-cart__lines" aria-live="polite">
            @foreach (var line in Cart.Lines)
            {
                <li class="shop-cart__line">
                    <div class="shop-cart__row">
                        <span class="shop-cart__name">@line.Name</span>
                        <span class="shop-cart__amt">@Money(line.LineTotal)<small>@Per(line.BillingInterval)</small></span>
                    </div>
                    <div class="shop-cart__row shop-cart__row--tools">
                        <span class="shop-qty">
                            <button type="button" @onclick="() => Cart.SetQuantity(line.Sku, line.Quantity - 1)" aria-label="@L["cart.less"]">−</button>
                            <span aria-live="polite">@line.Quantity</span>
                            <button type="button" disabled="@(line.Quantity >= CartState.MaxQuantity)"
                                    @onclick="() => Cart.SetQuantity(line.Sku, line.Quantity + 1)" aria-label="@L["cart.more"]">+</button>
                        </span>
                        @if (line.Quantity > 1)
                        {
                            <small class="shop-cart__each">@string.Format(L["cart.each"], Money(line.Price))</small>
                        }
                        <button type="button" class="shop-cart__remove" @onclick="() => Cart.Remove(line.Sku)">@L["shop.remove"]</button>
                    </div>
                </li>
            }
        </ul>

        <dl class="sh-cart__totals">
            @if (Cart.HasSubscription)
            {
                <div>
                    <dt>@(Cart.TrialDays > 0 ? string.Format(L["cart.aftertrial"], Cart.TrialDays) : L["cart.then"])</dt>
                    <dd>@Money(Cart.Recurring) <small>@Per(Cart.Lines.First(l => l.IsRecurring).BillingInterval)</small></dd>
                </div>
            }
            <div class="sh-cart__due">
                <dt>@L["cart.today"]</dt>
                <dd>@Money(Cart.DueToday)</dd>
            </div>
        </dl>

        @if (Cart.HasSubscription)
        {
            <p class="sh-cart__fine">@L["cart.renew"]</p>
        }
        @if (Cart.MixesCycles)
        {
            <p class="sh-cart__msg">@L["cart.mixed"]</p>
        }

        <div class="sh-cart__email">
            <label>
                <span>@L["cart.email"]</span>
                <input type="email" @bind="_email" autocomplete="email" maxlength="120" placeholder="you@example.com" />
            </label>
        </div>

        <div class="sh-cart__actions">
            <button type="button" class="btn btn-primary" disabled="@(_busy || Cart.MixesCycles)" @onclick="Checkout">
                @(_busy ? L["cart.wait"] : L["cart.checkout"])
            </button>
            <p class="sh-cart__fine">🔒 @L["cart.secure"]</p>
        </div>
    }

    @if (_msg is not null)
    {
        <p class="sh-cart__msg" role="status">@_msg</p>
    }

    @* For visitors still deciding: the demo form opens in place (TrialForm on the page). *@
    <p class="sh-cart__demo">@L["cart.demo"] <a href="javascript:void(0)" data-open-trial>@L["cart.demo.link"]</a></p>
</aside>

@if (Cart.Count > 0)
{
    <a class="sh-bar" href="@($"{Here}#cart")">
        <span>@string.Format(L["cart.items"], Cart.Count)</span>
        <span>@L["cart.today"] <strong>@Money(Cart.DueToday)</strong></span>
        <span class="sh-bar__go">@L["cart.view"] <span aria-hidden="true">↓</span></span>
    </a>
}

@code {
    [Parameter] public string Culture { get; set; } = "en";

    private string? _email;
    private bool _busy;
    private string? _msg;

    // This page's path relative to <base href="/">, so "#cart" links stay on it.
    private string Here => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];

    protected override void OnInitialized()
    {
        L.SetCulture(Culture);
        Cart.OnChange += OnCartChanged;
        // Back from Stripe without paying: the cart was saved, so it's all still here.
        if (new Uri(Nav.Uri).Query.Contains("checkout=cancelled")) _msg = L["cart.cancelled"];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Cart.RestoreAsync();
    }

    private async Task Checkout()
    {
        var email = _email?.Trim();
        if (string.IsNullOrEmpty(email) || !email.Contains('@') || email.Contains(' ') || email.Length > 120)
        {
            _msg = L["cart.needemail"];
            return;
        }

        _busy = true;
        _msg = null;
        var prefix = Culture == "en" ? "" : Culture + "/";
        var result = await Client.CreateOrderAsync(new CreateOrderRequest
        {
            Method = "Stripe",
            Email = email,
            Culture = Culture,
            SuccessUrl = $"{Nav.BaseUri}shop/success",
            CancelUrl = $"{Nav.BaseUri}{prefix}shop?checkout=cancelled",
            Items = Cart.Lines.Select(l => new CheckoutItem { Sku = l.Sku, Quantity = l.Quantity }).ToList()
        });

        if (result.Success && !string.IsNullOrWhiteSpace(result.StripeUrl))
        {
            Nav.NavigateTo(result.StripeUrl!, forceLoad: true);
            return;
        }

        _busy = false;
        _msg = result.Error ?? L["cart.fail"];
    }

    private string Money(decimal d) => ShopMoney.Format(d, Culture);

    private string Per(string interval) => interval switch
    {
        "Monthly" => " " + L["pr.month"],
        "Yearly" => " " + L["pr.year"],
        _ => "",
    };

    private async void OnCartChanged() => await InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.OnChange -= OnCartChanged;
}

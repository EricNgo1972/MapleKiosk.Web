@inject LocalizationService L
@inject NavigationManager Nav

<nav class="nav">
    <div class="nav__inner">
        <a class="nav__logo" href="@L.Path(L.Culture)#top">
            <img src="MapleKiosk_rectangle.png" alt="MapleKiosk" />
        </a>
        @* One Products menu instead of a link per product, so the bar holds however many there are.
           Opened by the same toggle as the user menu (site.js, data-user-menu / data-user-pop). *@
        <div class="user-menu nav-prod">
            <button type="button" class="nav-prod__btn @(OnProduct ? "active" : null)" data-user-menu aria-haspopup="true" aria-expanded="false">
                @L["nav.products"] <span class="user-badge__chev" aria-hidden="true">▾</span>
            </button>
            <div class="user-pop nav-prod__pop" data-user-pop>
                @foreach (var g in new[] { ProductGroup.Trade, ProductGroup.AddOn })
                {
                    <div class="nav-prod__group">
                        <p class="nav-prod__head">@L[g == ProductGroup.Trade ? "nav.group.trades" : "nav.group.addons"]</p>
                        @foreach (var p in SiteProducts.In(g))
                        {
                            <a class="nav-prod__item @Active(p.Slug)" href="@CulturePath(p.Slug)" aria-current="@Current(p.Slug)">
                                <strong>@L.ProductName(p)</strong>
                                <span>@L[$"prod.{p.Key}.for"]</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="lang-switch">
            <a href="@LangHref("en")" class="@(L.Culture == "en" ? "active" : "")">EN</a>
            <a href="@LangHref("fr")" class="@(L.Culture == "fr" ? "active" : "")">FR</a>
            <a href="@LangHref("vi")" class="@(L.Culture == "vi" ? "active" : "")">VI</a>
            <a href="@LangHref("ru")" class="@(L.Culture == "ru" ? "active" : "")">RU</a>
        </div>
        @if (ShowCta)
        {
            <a class="btn btn-primary nav__cta" href="javascript:void(0)" data-open-trial>@L["nav.cta"]</a>
        }
        <AuthorizeView>
            <Authorized>
                <div class="user-menu">
                    <button type="button" class="user-badge" data-user-menu aria-haspopup="true" aria-expanded="false">
                        <span class="user-badge__name">@context.User.Identity?.Name</span>
                        <span class="user-badge__chev" aria-hidden="true">▾</span>
                    </button>
                    <div class="user-pop" data-user-pop>
                        @if (context.User.IsInRole(AppAuthValidator.AdminRole))
                        {
                            <a class="user-pop__item" href="/shop/admin">
                                <span class="user-pop__icon" aria-hidden="true">🗂️</span>
                                <span>@L["nav.catalog"]</span>
                            </a>
                            <a class="user-pop__item" href="/onboarding/admin">
                                <span class="user-pop__icon" aria-hidden="true">📋</span>
                                <span>Onboarding</span>
                            </a>
                        }
                        else
                        {
                            <a class="user-pop__item" href="/onboarding">
                                <span class="user-pop__icon" aria-hidden="true">📋</span>
                                <span>@L["onb.title"]</span>
                            </a>
                        }
                        <form method="post" action="/logout" class="user-pop__form">
                            <button type="submit" class="user-pop__item">
                                <span class="user-pop__icon" aria-hidden="true">↩︎</span>
                                <span>@L["nav.signout"]</span>
                            </button>
                        </form>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    // Top-bar "Start free trial" CTA. Hidden on pages that don't want it (e.g. /nails).
    [Parameter] public bool ShowCta { get; set; } = true;

    // Base paths that have localized routes (/, /fr/<path>, ...). The language
    // switch keeps you on the current page for these; anything else falls back to
    // the localized home so we never link to a non-existent localized route.
    private static readonly HashSet<string> LocalizedPaths =
        new(new[] { "", "privacy", "terms", "tos" }
            .Concat(SiteProducts.All.Select(p => p.Slug))
            .Concat(SiteProducts.In(ProductGroup.Trade).Select(p => $"{p.Slug}/pricing")));

    // The page you're on, without its culture prefix: "/fr/coffee" -> "coffee".
    private string CurrentPage
    {
        get
        {
            var segs = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0]
                .Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();
            if (segs.Count > 0 && segs[0] is "fr" or "vi" or "ru") segs.RemoveAt(0);
            return segs.FirstOrDefault() ?? "";
        }
    }

    private bool OnProduct => SiteProducts.All.Any(p => p.Slug == CurrentPage);

    private string? Active(string page) => CurrentPage == page ? "active" : null;
    private string? Current(string page) => CurrentPage == page ? "page" : null;

    private string CulturePath(string page)
    {
        var root = L.Path(L.Culture).TrimEnd('/');
        return string.IsNullOrEmpty(root) ? $"/{page}" : $"{root}/{page}";
    }

    private string LangHref(string culture)
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].Trim('/');
        var segs = rel.Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (segs.Count > 0 && segs[0] is "fr" or "vi" or "ru") segs.RemoveAt(0);
        var basePath = string.Join('/', segs);
        if (!LocalizedPaths.Contains(basePath)) basePath = "";
        if (culture == "en") return basePath == "" ? "/" : $"/{basePath}";
        return basePath == "" ? $"/{culture}" : $"/{culture}/{basePath}";
    }
}

@inject LocalizationService L

<footer class="footer">
    <div class="container">
        <div class="footer__top">
            <div class="footer__brand">
                <div class="footer__logo"><img src="MapleKiosk_rectangle.png" alt="MapleKiosk" /></div>
                <p>@L["foot.brand"]</p>
            </div>
            <div class="footer__col">
                <h5>@L["nav.products"]</h5>
                <ul>
                    @foreach (var p in SiteProducts.All)
                    {
                        <li><a href="@CulturePath(p.Slug)">@L.ProductName(p)</a></li>
                    }
                </ul>
            </div>
            <div class="footer__col">
                <h5>@L["foot.watch"]</h5>
                <ul>
                    <li><a href="https://www.youtube.com/@@ericngo2228" target="_blank" rel="noopener">@L["foot.videos"]</a></li>
                    <li><a href="javascript:void(0)" data-open-trial>@L["nav.cta"]</a></li>
                    <li><a href="/login">@L["nav.signin"]</a></li>
                </ul>
            </div>
            <div class="footer__col">
                <h5>@L["foot.legal"]</h5>
                <ul>
                    <li><a href="@CulturePath("privacy")">@L["foot.privacy"]</a></li>
                    <li><a href="@CulturePath("terms")">@L["foot.terms"]</a></li>
                    <li><a href="@CulturePath("sms-terms")">@L["foot.sms"]</a></li>
                </ul>
            </div>
        </div>
        <div class="footer__bottom">
            <span>© @DateTime.Now.Year Kiosque &Eacute;rable Inc. (MapleKiosk). @L["foot.rights"]</span>
            <span>@L["foot.made"]</span>
        </div>
    </div>
</footer>

@code {
    private string CulturePath(string page)
    {
        var root = L.Path(L.Culture).TrimEnd('/');
        return string.IsNullOrEmpty(root) ? $"/{page}" : $"{root}/{page}";
    }
}

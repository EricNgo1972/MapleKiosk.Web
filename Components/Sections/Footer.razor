@inject LocalizationService L

<footer class="footer">
    <div class="container">
        <div class="footer__top">
            <div class="footer__brand">
                <div class="footer__logo"><img src="MapleKiosk_rectangle.png" alt="MapleKiosk" /></div>
                <p>@L["foot.brand"]</p>
            </div>
            <div class="footer__col">
                <h5>@L["foot.product"]</h5>
                <ul>
                    <li><a href="@L.Path(L.Culture)#apps">@L["nav.apps"]</a></li>
                    <li><a href="@L.Path(L.Culture)#pricing">@L["nav.pricing"]</a></li>
                    <li><a href="@L.Path(L.Culture)#how">@L["nav.how"]</a></li>
                </ul>
            </div>
            <div class="footer__col">
                <h5>@L["foot.industries"]</h5>
                <ul>
                    <li><a href="@CulturePath("nails")">@L["ind.nail"]</a></li>
                    <li><a href="@CulturePath("restaurants")">@L["ind.resto"]</a></li>
                    <li><a href="@CulturePath("coffee")">@L["ind.coffee"]</a></li>
                </ul>
            </div>
            <div class="footer__col">
                <h5>@L["foot.legal"]</h5>
                <ul>
                    <li><a href="@CulturePath("privacy")">@L["foot.privacy"]</a></li>
                    <li><a href="@CulturePath("terms")">@L["foot.terms"]</a></li>
                </ul>
            </div>
        </div>
        <div class="footer__bottom">
            <span>© @DateTime.Now.Year MapleKiosk Inc. @L["foot.rights"]</span>
            <span>@L["foot.made"]</span>
        </div>
    </div>
</footer>

@code {
    private string CulturePath(string page)
    {
        var root = L.Path(L.Culture).TrimEnd('/');
        return string.IsNullOrEmpty(root) ? $"/{page}" : $"{root}/{page}";
    }
}

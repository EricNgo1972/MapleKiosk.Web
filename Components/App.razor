<!DOCTYPE html>
<html lang="@_culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="canonical" href="@SiteHost.Canonical(Nav.ToBaseRelativePath(Nav.Uri))" />
    @if (!SiteHost.IsPublic(Nav.BaseUri))
    {
        @* The dev box (web.maplekiosk.ca) and localhost stay out of search engines and AI indexes. *@
        <meta name="robots" content="noindex, nofollow" />
    }
    @if (NavBar.LocalizedPaths.Contains(_page))
    {
        @* The page in each language, so search engines show the right one and don't count them as copies. *@
        foreach (var lang in Languages)
        {
            <link rel="alternate" hreflang="@lang" href="@(SiteHost.Root + PathIn(lang))" />
        }
        <link rel="alternate" hreflang="x-default" href="@(SiteHost.Root + PathIn("en"))" />
    }

    @* Title and description come from each page (<PageTitle>, <HeadContent>) — a fixed one here
       would be emitted first and win over every page's own. *@


    <link rel="icon" type="image/x-icon" href="favicon.ico?v=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="css/site.css?v=59" />
    <link rel="stylesheet" href="_content/MapleShop.UI/css/mapleshop.css?v=2" />
    <link rel="stylesheet" href="MapleKiosk.Web.styles.css?v=2" />
    <HeadOutlet />
    @* Clicks before site.js is wired up (blazor.web.js and site.js take a second or two on a slow
       connection) used to do nothing. Show the busy state right away and remember a "Book a demo"
       click; site.js opens the form once it loads (mkPendingTrial). *@
    <script>
        document.addEventListener('click', function (ev) {
            if (window.mkReady || ev.button !== 0) return;
            var t = ev.target.closest && ev.target.closest('[data-open-trial],a[href]');
            if (!t || t.hasAttribute('data-video')) return;
            if (t.hasAttribute('data-open-trial')) { ev.preventDefault(); window.mkPendingTrial = true; }
            else if (t.target || t.origin !== location.origin || t.pathname === location.pathname) return;
            t.classList.add('nav-pending');
            document.documentElement.classList.add('nav-busy');
        }, true);
    </script>
    @if (!string.IsNullOrEmpty(_gaId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@_gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@_gaId');
        </script>
    }
</head>
<body>
    <Routes />
    <script type="application/ld+json">@((MarkupString)OrgJson())</script>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/site.js?v=31"></script>
    <script src="js/assistant.js?v=3"></script>
</body>
</html>

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private static readonly string[] Languages = ["en", "fr", "vi", "ru"];

    private string? _gaId;
    private string _culture = "en";  // the page's language, from its /fr, /vi or /ru prefix
    private string _page = "";       // the page without that prefix: "/fr/garage" -> "garage"

    protected override void OnInitialized()
    {
        _gaId = Config["Analytics:GaMeasurementId"];
        var segs = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0]
            .Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (segs.Count > 0 && segs[0] is "fr" or "vi" or "ru")
        {
            _culture = segs[0];
            segs.RemoveAt(0);
        }
        _page = string.Join('/', segs);
    }

    private string PathIn(string lang) => lang == "en" ? _page : _page == "" ? lang : $"{lang}/{_page}";

    private string OrgJson() => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Organization",
        ["name"] = "MapleKiosk",
        ["legalName"] = "Kiosque Érable Inc.",
        ["url"] = Nav.BaseUri,
        ["logo"] = $"{Nav.BaseUri}MapleKiosk_rectangle.png"
    });
}

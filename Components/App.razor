<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    @* Title and description come from each page (<PageTitle>, <HeadContent>) — a fixed one here
       would be emitted first and win over every page's own. *@


    <link rel="icon" type="image/x-icon" href="favicon.ico?v=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="css/site.css?v=38" />
    <link rel="stylesheet" href="_content/MapleShop.UI/css/mapleshop.css?v=2" />
    <link rel="stylesheet" href="MapleKiosk.Web.styles.css?v=2" />
    <HeadOutlet />
    @if (!string.IsNullOrEmpty(_gaId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@_gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@_gaId');
        </script>
    }
</head>
<body>
    <Routes />
    <script type="application/ld+json">@((MarkupString)OrgJson())</script>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/site.js?v=22"></script>
</body>
</html>

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private string? _gaId;

    protected override void OnInitialized() => _gaId = Config["Analytics:GaMeasurementId"];

    private string OrgJson() => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Organization",
        ["name"] = "MapleKiosk",
        ["legalName"] = "Kiosque Érable Inc.",
        ["url"] = Nav.BaseUri,
        ["logo"] = $"{Nav.BaseUri}MapleKiosk_rectangle.png"
    });
}

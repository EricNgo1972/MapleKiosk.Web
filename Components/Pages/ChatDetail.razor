@page "/chats/{Id}"
@attribute [Authorize(Roles = AppAuthValidator.AdminRole)]
@rendermode InteractiveServer
@implements IDisposable
@using MapleKiosk.Web.Assistant
@inject ChatLog Log

@* One conversation on its own page (a long chat reads top to bottom like any page). Refreshes
   every few seconds while it's live. *@

<PageTitle>@(_conv?.Contact?.Name ?? "Guest") — Chats — MapleKiosk</PageTitle>

<header class="onb-top">
    <div class="container onb-top__inner">
        <a href="/" class="onb-top__logo"><img src="/MapleKiosk_rectangle.png" alt="MapleKiosk" /></a>
        <span class="adm-title"><a href="/admin" style="color:inherit;text-decoration:none">Admin</a> / <a href="/chats" style="color:inherit;text-decoration:none">Chats</a></span>
    </div>
</header>

<main class="adm">
    <div class="container adm__wrap">
        <p style="margin:0 0 14px"><a href="/chats" class="adm-link">← All chats</a></p>

        @if (_loading)
        {
            <p class="onb__muted">Loading…</p>
        }
        else if (_conv is not { } conv)
        {
            <div class="adm-empty">
                <p><strong>Conversation not found</strong></p>
                <p class="onb__muted">It may be older than the log keeps.</p>
            </div>
        }
        else
        {
            <h1 style="font-size:24px;margin:0 0 6px">@(conv.Contact?.Name ?? "Guest")</h1>
            <p class="onb__muted" style="margin:0 0 16px">
                Started @conv.StartedAt.ToLocalTime().ToString("MMM d, h:mm tt") · @Ago(conv.LastAt)
                @if (IsLive(conv)) { <span class="cht-live" style="margin-left:6px">Live</span> }
            </p>

            @if (conv.Contact is { } who)
            {
                <div class="cht-card">
                    <p><strong>@who.Name</strong>@(who.Business is null ? "" : $" · {who.Business}")</p>
                    @if (who.Phone is not null) { <p>📞 <a href="tel:@who.Phone">@who.Phone</a></p> }
                    @if (who.Email is not null) { <p>✉️ <a href="mailto:@who.Email">@who.Email</a></p> }
                    @if (who.Interest is not null) { <p class="onb__muted">Interested in: @who.Interest</p> }
                </div>
            }

            <dl class="cht-meta">
                <div><dt>Language</dt><dd>@conv.Lang.ToUpperInvariant()</dd></div>
                <div><dt>Came in on</dt><dd>@conv.FirstPage</dd></div>
                <div><dt>Last page</dt><dd>@conv.LastPage</dd></div>
                <div><dt>Device</dt><dd>@(conv.Device ?? "—")@(conv.Country is { Length: > 0 } cc ? $" · {cc}" : "")</dd></div>
                <div><dt>Messages</dt><dd>@_lines.Count</dd></div>
            </dl>

            <div class="cht-log">
                @foreach (var m in _lines)
                {
                    <div class="cht-line cht-line--@(m.Role == "user" ? "me" : "bot")">
                        <div class="cht-b">@m.Text</div>
                        <small>@m.At.ToLocalTime().ToString("MMM d, h:mm tt")@(m.Role == "user" && m.Page is { } pg ? $" · {pg}" : "")</small>
                    </div>
                }
            </div>
        }
    </div>
</main>

@code {
    [Parameter] public string Id { get; set; } = "";

    private static readonly TimeSpan Refresh = TimeSpan.FromSeconds(5);
    private static readonly TimeSpan LiveWindow = TimeSpan.FromMinutes(3);

    private ChatConversation? _conv;
    private List<ChatLine> _lines = new();
    private bool _loading = true;
    private PeriodicTimer? _timer;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync(_cts.Token);
        _loading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _timer = new PeriodicTimer(Refresh);
        _ = TickAsync(_cts.Token);
    }

    private async Task TickAsync(CancellationToken ct)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(ct))
            {
                if (_conv is null || !IsLive(_conv)) continue; // a finished chat doesn't change
                await LoadAsync(ct);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task LoadAsync(CancellationToken ct)
    {
        try
        {
            _conv = await Log.GetAsync(Id) ?? _conv;
            if (_conv is not null) _lines = await Log.MessagesAsync(Id, ct);
        }
        catch { /* keep what's shown; a storage hiccup shouldn't blank the page */ }
    }

    private static bool IsLive(ChatConversation c) => DateTimeOffset.UtcNow - c.LastAt < LiveWindow;

    private static string Ago(DateTimeOffset at)
    {
        var d = DateTimeOffset.UtcNow - at;
        return d.TotalMinutes < 1 ? "just now"
             : d.TotalHours < 1 ? $"{(int)d.TotalMinutes} min ago"
             : d.TotalDays < 1 ? $"{(int)d.TotalHours} h ago"
             : d.TotalDays < 7 ? $"{(int)d.TotalDays} d ago"
             : at.ToLocalTime().ToString("MMM d");
    }

    public void Dispose()
    {
        _cts.Cancel();
        _timer?.Dispose();
        _timer = null;
        _cts.Dispose();
    }
}

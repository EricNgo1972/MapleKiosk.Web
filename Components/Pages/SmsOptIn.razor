@page "/sms-opt-in"
@page "/fr/sms-opt-in"
@page "/vi/sms-opt-in"
@page "/ru/sms-opt-in"
@inject LocalizationService L
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

<PageTitle>SMS Opt-in — MapleKiosk</PageTitle>
<HeadContent>
    <meta name="description" content="How customers consent to receive appointment text messages sent through MapleKiosk." />
</HeadContent>

<NavBar />

<main class="legal-page">
    <Breadcrumbs Current="@L["foot.smsoptin"]" />
    <div class="container">
        <div class="legal-page__head">
            <span class="eyebrow">@L["foot.legal"]</span>
            <h1>How customers opt in to text messages</h1>
            <p>Last updated: September 14, 2026</p>
        </div>

        <div class="legal-page__body">
            <section>
                <p>This page shows how customers consent to receive text messages sent through MapleKiosk apps by Kiosque &Eacute;rable Inc., operating as MapleKiosk, for the business they booked with (the "<strong>Business</strong>"). It is public so customers and mobile carriers can verify the opt-in process.</p>
            </section>

            <section>
                <h2>Where consent is collected</h2>
                <p>Customers type their own mobile number on the Business's check-in screen (a touch-screen kiosk at the front desk) or booking form. Next to the phone-number field is a checkbox that is <strong>unchecked by default</strong>:</p>
                <div class="sms-consent">
                    <span class="sms-consent__box" aria-hidden="true"></span>
                    <span>Text me appointment confirmations and reminders from [Business name]. Message frequency varies. Message and data rates may apply. Reply STOP to opt out, HELP for help. SMS Terms: maplekiosk.ca/sms-terms &middot; Privacy: maplekiosk.ca/privacy</span>
                </div>
                <p>[Business name] is replaced with the name of the salon or business on its own check-in screen.</p>
                <ul>
                    <li>A customer who leaves the box unchecked can still book, and receives no text messages.</li>
                    <li>Consent is not a condition of any purchase or booking.</li>
                    <li>Each consent is recorded with the phone number, the date and time, and the wording shown.</li>
                </ul>
            </section>

            @if (_shots.Count > 0)
            {
                <section>
                    <h2>Screenshots of the check-in screen</h2>
                    <div class="sms-shots">
                        @for (var i = 0; i < _shots.Count; i++)
                        {
                            var n = i + 1;
                            <figure><img src="/img/sms-opt-in/@Uri.EscapeDataString(_shots[i])" alt="Check-in screen, step @n" loading="lazy" /></figure>
                        }
                    </div>
                </section>
            }

            <section>
                <h2>What customers receive</h2>
                <p>Only transactional messages about their booking. For example:</p>
                <div class="sms-sample">[Business name]: Hi [first name], your [service] appointment is confirmed for [date] at [time]. Reply STOP to opt out, HELP for help.</div>
                <div class="sms-sample">[Business name]: Reminder: your appointment is tomorrow at [time]. To change it, call [business phone]. Reply STOP to opt out.</div>
            </section>

            <section>
                <h2>Opting out and help</h2>
                <p>Customers can reply <strong>STOP</strong> to any message to stop receiving texts, or <strong>HELP</strong> for help. Full details are in our <a href="/sms-terms">SMS Terms</a> and <a href="/privacy">Privacy Policy</a>. Questions: <a data-user="dev" data-domain="maplekiosk.ca">dev [at] maplekiosk.ca</a>.</p>
            </section>
        </div>
    </div>
</main>

<Footer />

@code {
    // Screenshots are picked up from wwwroot/img/sms-opt-in/ (sorted by file name),
    // so dropping real kiosk captures there is enough; no code change needed.
    private static readonly string[] ImageExtensions = [".png", ".jpg", ".jpeg", ".webp"];
    private List<string> _shots = [];

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var seg = uri.AbsolutePath.Trim('/').Split('/').FirstOrDefault() ?? "";
        L.SetCulture(seg);

        var dir = Path.Combine(Env.WebRootPath, "img", "sms-opt-in");
        if (Directory.Exists(dir))
            _shots = Directory.EnumerateFiles(dir)
                .Where(f => ImageExtensions.Contains(Path.GetExtension(f).ToLowerInvariant()))
                .Select(f => Path.GetFileName(f))
                .Order()
                .ToList();
    }
}

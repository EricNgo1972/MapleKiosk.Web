@page "/restaurants"
@page "/fr/restaurants"
@page "/vi/restaurants"
@page "/ru/restaurants"
@inject LocalizationService L
@inject NavigationManager Nav

<PageTitle>@L["rp.meta.title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["rp.meta.desc"]" />
    <meta property="og:title" content="@L["rp.meta.title"]" />
    <meta property="og:description" content="@L["rp.meta.desc"]" />
    <meta property="og:url" content="@Nav.Uri" />
    <meta property="og:image" content="@(Nav.BaseUri)img/restaurant/hero.jpg" />
</HeadContent>

<NavBar />

<main class="gp">

    <!-- ===================== HERO ===================== -->
    <section class="gp-hero" id="top">
        <Breadcrumbs Current="@L["nav.resto"]" />
        <div class="container gp-hero__grid">
            <div>
                <p class="gp-hero__product">MaplePOS</p>
                <h1 class="gp-hero__title">@L["rp.hero.title"]</h1>
                <p class="gp-hero__sub">@L["rp.hero.sub"]</p>
                <div class="gp-hero__ctas">
                    <a class="btn btn-primary" href="javascript:void(0)" data-open-trial>@L["nav.cta"]</a>
                    <button type="button" class="btn gp-btn-ghost" data-video="@Overview.En" data-video-fr="@Overview.Fr">
                        @L["rp.hero.watch"] <span @attributes="Len(Overview)">@Length(Overview)</span>
                    </button>
                </div>
                <p class="gp-hero__note">@L["rp.hero.note"]</p>
                <a class="hp-link spa-price" href="@PricingPath">@L["spa.cta.pricing"] <span aria-hidden="true">→</span></a>
                <div class="film-lang" role="group" aria-label="@L["rp.lang"]">
                    <span>@L["rp.lang"]</span>
                    <button type="button" data-film-lang="en" lang="en" aria-pressed="@((Default == "en").ToString().ToLowerInvariant())">English</button>
                    <button type="button" data-film-lang="fr" lang="fr" aria-pressed="@((Default == "fr").ToString().ToLowerInvariant())">Français</button>
                </div>
            </div>
            <button type="button" class="gp-shot gp-shot--hero" data-video="@Overview.En" data-video-fr="@Overview.Fr"
                    aria-label="@($"{L["rp.watch"]}: {L["rp.hero.watch"]}")">
                <img src="img/restaurant/hero.jpg" alt="@L["rp.hero.alt"]" width="1280" height="720" />
                <span class="hp-play" aria-hidden="true"></span>
            </button>
        </div>
    </section>

    <!-- ===================== ONE NIGHT OF SERVICE ===================== -->
    <section class="gp-day">
        <div class="container">
            <h2 class="gp-h2">@L["rp.night.title"]</h2>
            <p class="gp-lead">@L["rp.night.sub"]</p>

            <ol class="gp-steps">
                @for (var i = 0; i < _films.Length; i++)
                {
                    var f = _films[i];
                    <li class="gp-step @(i % 2 == 1 ? "gp-step--flip" : "")">
                        <button type="button" class="gp-shot gp-shot--film" data-video="@f.En" data-video-fr="@f.Fr"
                                aria-label="@($"{L["rp.watch"]}: {L[$"rp.s.{f.Key}.t"]}")">
                            <img src="img/restaurant/@(f.Key).jpg" alt="@L[$"rp.s.{f.Key}.alt"]" loading="lazy" width="1280" height="720" />
                            <span class="hp-play" aria-hidden="true"></span>
                        </button>
                        <div class="gp-step__body">
                            <span class="gp-step__num">@(i + 1)</span>
                            <h3>@L[$"rp.s.{f.Key}.t"]</h3>
                            <p>@L[$"rp.s.{f.Key}.d"]</p>
                            <button type="button" class="hp-link" data-video="@f.En" data-video-fr="@f.Fr">
                                @L["rp.watch"] <span @attributes="Len(f)">@Length(f)</span>
                            </button>
                        </div>
                    </li>
                }
            </ol>
        </div>
    </section>

    <!-- ===================== CLOSE ===================== -->
    <section class="gp-end">
        <div class="container">
            <h2 class="gp-h2">@L["rp.end.title"]</h2>
            <div class="hp-end__actions">
                <a class="btn btn-primary" href="javascript:void(0)" data-open-trial>@L["nav.cta"]</a>
                <a class="btn gp-btn-ghost" href="@PricingPath">@L["spa.cta.pricing"]</a>
                <span>@L["hp.end.or"] <a data-user="sales" data-domain="maplekiosk.ca">sales [at] maplekiosk.ca</a></span>
            </div>
        </div>
    </section>

</main>

<TrialForm Culture="@L.Culture" />
<Footer />
<MobileCta />

@code {
    // The "Meet MaplePOS" films on the Maple Kiosk YouTube channel, one playlist per language:
    // English "MaplePOS: your whole restaurant, one floor" (PLSRbUy6KcG6U) and French
    // "Découvrez MaplePOS" (PLDtkmLGiaJb0). The visitor picks the language (site.js remembers it);
    // the French page starts in French, every other page in English.
    private record FilmInfo(string Key, string En, string EnLength, string Fr, string FrLength);

    private static readonly FilmInfo Overview = new("hero", "yNZny11acfk", "0:52", "dvio2Pc7DQQ", "0:56");

    // Ordered as one night of service: the book fills, the floor runs, the bill closes, the week after.
    private readonly FilmInfo[] _films =
    {
        new("book",     "g5qjmIv-xnY", "1:19", "UO_YqWy5gIA", "1:28"),
        new("phone",    "2SLdSOflvIM", "1:17", "nvqCqa6-6ow", "1:30"),
        new("floor",    "PIgmafCS_Fo", "1:08", "Q11LB20gRlY", "1:14"),
        new("qr",       "p701-06Dhqo", "1:12", "G3ENTSur3ik", "1:16"),
        new("kitchen",  "evf6wCDIirE", "1:10", "YSUYnh1Z_jI", "1:11"),
        new("bill",     "hJiZ4VKCFok", "1:10", "5qKT4qKsU40", "1:16"),
        new("tips",     "71u7Ylsjf_s", "1:12", "bW4pK_uNf3Q", "1:20"),
        new("regulars", "Rhe8uYCOzxU", "1:08", "x0g8J87PY9s", "1:14"),
        new("menu",     "rOqKCAwLaY0", "1:10", "190OK7pMQqA", "1:16"),
    };

    private string Default => L.Culture == "fr" ? "fr" : "en";
    private string Length(FilmInfo f) => Default == "fr" ? f.FrLength : f.EnLength;
    // Both lengths on the label, so site.js can swap it when the visitor changes language.
    private static Dictionary<string, object> Len(FilmInfo f) => new() { ["data-len-en"] = f.EnLength, ["data-len-fr"] = f.FrLength };

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var seg = uri.AbsolutePath.Trim('/').Split('/').FirstOrDefault() ?? "";
        L.SetCulture(seg);
    }

    private string PricingPath => L.Culture == "en" ? "/restaurants/pricing" : $"/{L.Culture}/restaurants/pricing";
}

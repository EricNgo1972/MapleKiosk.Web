@page "/restaurants"
@page "/fr/restaurants"
@page "/vi/restaurants"
@page "/ru/restaurants"
@inject LocalizationService L
@inject NavigationManager Nav

<PageTitle>@L["rp.meta.title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["rp.meta.desc"]" />
    <meta property="og:title" content="@L["rp.meta.title"]" />
    <meta property="og:description" content="@L["rp.meta.desc"]" />
    <meta property="og:url" content="@Nav.Uri" />
    <meta property="og:image" content="@(Nav.BaseUri)img/restaurant/hero.jpg" />
</HeadContent>

<NavBar />

<main class="gp">

    <!-- ===================== HERO ===================== -->
    <section class="gp-hero" id="top">
        <Breadcrumbs Current="@L["nav.resto"]" />
        <div class="container gp-hero__grid">
            <div>
                <p class="gp-hero__product">MaplePOS</p>
                <h1 class="gp-hero__title">@L["rp.hero.title"]</h1>
                <p class="gp-hero__sub">@L["rp.hero.sub"]</p>
                <div class="gp-hero__ctas">
                    <a class="btn btn-primary" href="javascript:void(0)" data-open-trial>@L["nav.cta"]</a>
                    <button type="button" class="btn gp-btn-ghost" data-video="@Film(Overview)">
                        @L["rp.hero.watch"] <span>@Overview.Length</span>
                    </button>
                </div>
                <p class="gp-hero__note">@L["rp.hero.note"]</p>
            </div>
            <button type="button" class="gp-shot gp-shot--hero" data-video="@Film(Overview)"
                    aria-label="@($"{L["rp.watch"]}: {L["rp.hero.watch"]} ({Overview.Length})")">
                <img src="img/restaurant/hero.jpg" alt="@L["rp.hero.alt"]" width="1280" height="720" />
                <span class="hp-play" aria-hidden="true"></span>
            </button>
        </div>
    </section>

    <!-- ===================== ONE NIGHT OF SERVICE ===================== -->
    <section class="gp-day">
        <div class="container">
            <h2 class="gp-h2">@L["rp.night.title"]</h2>
            <p class="gp-lead">@L["rp.night.sub"]</p>

            <ol class="gp-steps">
                @for (var i = 0; i < _films.Length; i++)
                {
                    var f = _films[i];
                    <li class="gp-step @(i % 2 == 1 ? "gp-step--flip" : "")">
                        <button type="button" class="gp-shot gp-shot--film" data-video="@Film(f)"
                                aria-label="@($"{L["rp.watch"]}: {L[$"rp.s.{f.Key}.t"]} ({f.Length})")">
                            <img src="img/restaurant/@(f.Key).jpg" alt="@L[$"rp.s.{f.Key}.alt"]" loading="lazy" width="1280" height="720" />
                            <span class="hp-play" aria-hidden="true"></span>
                        </button>
                        <div class="gp-step__body">
                            <span class="gp-step__num">@(i + 1)</span>
                            <h3>@L[$"rp.s.{f.Key}.t"]</h3>
                            <p>@L[$"rp.s.{f.Key}.d"]</p>
                            <button type="button" class="hp-link" data-video="@Film(f)">
                                @L["rp.watch"] <span>@f.Length</span>
                            </button>
                        </div>
                    </li>
                }
            </ol>
        </div>
    </section>

    <!-- ===================== CLOSE ===================== -->
    <section class="gp-end">
        <div class="container">
            <h2 class="gp-h2">@L["rp.end.title"]</h2>
            <div class="hp-end__actions">
                <a class="btn btn-primary" href="javascript:void(0)" data-open-trial>@L["nav.cta"]</a>
                <span>@L["hp.end.or"] <a data-user="sales" data-domain="maplekiosk.ca">sales [at] maplekiosk.ca</a></span>
            </div>
        </div>
    </section>

</main>

<TrialForm Culture="@L.Culture" />
<Footer />
<MobileCta />

@code {
    // The "Meet MaplePOS" films (MaplePOS repo, docs/videos/episodes/<file>/out/<file>.mp4).
    // YouTube = the video id once it's on the Maple Kiosk channel — paste it in and the page plays
    // it from YouTube. Until then (null) the film plays from /media/restaurant/<file>.mp4 (private
    // blob container site-media, streamed by the site).
    private record FilmInfo(string Key, string File, string Length, string? YouTube = null);

    private static readonly FilmInfo Overview = new("hero", "m1-overview", "0:52", YouTube: null);

    // Ordered as one night of service: the book fills, the floor runs, the bill closes, the week after.
    private readonly FilmInfo[] _films =
    {
        new("book",     "m6-full-book",            "1:19", YouTube: null),
        new("phone",    "m5-book-while-you-sleep", "1:17", YouTube: null),
        new("floor",    "m2-next-move",            "1:08", YouTube: null),
        new("qr",       "m3-table-qr-languages",   "1:12", YouTube: null),
        new("kitchen",  "m4-kitchen-sync",         "1:10", YouTube: null),
        new("bill",     "m7-bill-in-seconds",      "1:10", YouTube: null),
        new("tips",     "m8-tips-payday",          "1:12", YouTube: null),
        new("regulars", "m9-regulars",             "1:08", YouTube: null),
        new("menu",     "m10-menu-once",           "1:10", YouTube: null),
    };

    // data-video value for the lightbox: a YouTube id, or the site-served file.
    private static string Film(FilmInfo f) => f.YouTube ?? $"/media/restaurant/{f.File}.mp4";

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var seg = uri.AbsolutePath.Trim('/').Split('/').FirstOrDefault() ?? "";
        L.SetCulture(seg);
    }
}

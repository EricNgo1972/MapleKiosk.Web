@page "/nails"
@page "/fr/nails"
@page "/vi/nails"
@page "/ru/nails"
@layout Layout.NailsLayout
@inject LocalizationService L
@inject NavigationManager Nav

<PageTitle>@L["spa.meta.title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["spa.meta.desc"]" />
    <meta property="og:title" content="@L["spa.meta.title"]" />
    <meta property="og:description" content="@L["spa.meta.desc"]" />
    <meta property="og:url" content="@Nav.Uri" />
    <meta property="og:image" content="@(Nav.BaseUri)img/nails/hero.jpg" />
</HeadContent>

<NavBar />

<main class="gp">

    <!-- ===================== HERO ===================== -->
    <section class="gp-hero" id="top">
        <Breadcrumbs Current="@L["ind.nail"]" />
        <div class="container gp-hero__grid">
            <div>
                <p class="gp-hero__product">MapleSPA</p>
                <h1 class="gp-hero__title">@L["spa.hero.title"]</h1>
                <p class="gp-hero__sub">@L["spa.hero.sub"]</p>
                <div class="gp-hero__ctas">
                    <a class="btn btn-primary" href="@TestDrive" target="_blank" rel="noopener">@L["spa.cta.trial"]</a>
                    <button type="button" class="btn gp-btn-ghost" @attributes="Cuts(Overview)">
                        @L["spa.hero.watch"] <span @attributes="Len(Overview)">@Length(Overview)</span>
                    </button>
                </div>
                <p class="gp-hero__note">@L["spa.hero.note"]</p>
                <div class="film-lang" role="group" aria-label="@L["spa.lang"]">
                    <span>@L["spa.lang"]</span>
                    <button type="button" data-film-lang="vi" lang="vi" aria-pressed="@((Default == "vi").ToString().ToLowerInvariant())">Tiếng Việt</button>
                    <button type="button" data-film-lang="ru" lang="ru" aria-pressed="@((Default == "ru").ToString().ToLowerInvariant())">Русский</button>
                </div>
            </div>
            <button type="button" class="gp-shot gp-shot--hero" @attributes="Cuts(Overview)"
                    aria-label="@($"{L["spa.watch"]}: {L["spa.hero.watch"]}")">
                <img src="img/nails/hero.jpg" alt="@L["spa.hero.alt"]" width="1280" height="720" />
                <span class="hp-play" aria-hidden="true"></span>
            </button>
        </div>
    </section>

    <!-- ===================== WHAT IT TAKES OFF YOUR PLATE ===================== -->
    <section class="gp-day">
        <div class="container">
            <h2 class="gp-h2">@L["spa.day.title"]</h2>
            <p class="gp-lead">@L["spa.day.sub"]</p>

            <ol class="gp-steps">
                @for (var i = 0; i < _films.Length; i++)
                {
                    var f = _films[i];
                    <li class="gp-step @(i % 2 == 1 ? "gp-step--flip" : "")">
                        <button type="button" class="gp-shot gp-shot--film" @attributes="Cuts(f)"
                                aria-label="@($"{L["spa.watch"]}: {L[$"spa.s.{f.Key}.t"]}")">
                            <img src="img/nails/@(f.Key).jpg" alt="@L[$"spa.s.{f.Key}.alt"]" loading="lazy" width="1280" height="720" />
                            <span class="hp-play" aria-hidden="true"></span>
                        </button>
                        <div class="gp-step__body">
                            <span class="gp-step__num">@(i + 1)</span>
                            <h3>@L[$"spa.s.{f.Key}.t"]</h3>
                            <p>@L[$"spa.s.{f.Key}.d"]</p>
                            <button type="button" class="hp-link" @attributes="Cuts(f)">
                                @L["spa.watch"] <span @attributes="Len(f)">@Length(f)</span>
                                @if (f.Vi is null)
                                {
                                    <span>· @L["spa.ru.only"]</span>
                                }
                            </button>
                        </div>
                    </li>
                }
            </ol>
        </div>
    </section>

    <!-- ===================== CLOSE ===================== -->
    <section class="gp-end">
        <div class="container">
            <h2 class="gp-h2">@L["spa.end.title"]</h2>
            <div class="hp-end__actions">
                <a class="btn btn-primary" href="javascript:void(0)" data-open-trial>@L["nav.cta"]</a>
                <a class="btn gp-btn-ghost" href="@TestDrive" target="_blank" rel="noopener">@L["spa.cta.trial"]</a>
                <span>@L["hp.end.or"] <a data-user="sales" data-domain="maplekiosk.ca">sales [at] maplekiosk.ca</a></span>
            </div>
        </div>
    </section>

</main>

<TrialForm Culture="@L.Culture" />
<Footer />
<MobileCta Href="@TestDrive" Label="@L["spa.cta.trial"]" />

@code {
    private const string TestDrive = "https://nails.maplekiosk.ca";

    // The "MapleSPA" films on the Maple Kiosk YouTube channel, one playlist per language:
    // Vietnamese "Nails and SPA" (PLcZPSrx-Gm5c) and Russian "MapleSPA _ru" (PLFRENlV4DHg8).
    // The photo-advice film is only in Russian so far (Vi = null). The visitor picks the language
    // (site.js remembers it); the Russian page starts in Russian, every other page in Vietnamese.
    private record FilmInfo(string Key, string? Vi, string? ViLength, string Ru, string RuLength);

    private static readonly FilmInfo Overview = new("hero", "UbmRsBF2aNI", "0:47", "PvruNdaH_C4", "0:54");

    // Ordered as a salon day: turns and bookings, the phone, the rush, checkout, then payday and promotions.
    private readonly FilmInfo[] _films =
    {
        new("turns",    "pO7CuFU-pm8", "1:03", "2Q9yaKK-glk", "1:10"),
        new("book",     "hcGvxU58y2w", "1:00", "weVV7Fn8XGM", "1:05"),
        new("phone",    "n1Src-4w5MY", "1:22", "ePsVx2Hy4iE", "1:29"),
        new("walkins",  "1o9EnqKohno", "1:00", "5Mo5EY5fgyM", "1:08"),
        new("checkout", "SQOIlX99CJc", "0:51", "OKK5rJ-9o60", "0:57"),
        new("payday",   "hxv4R9S6c5w", "1:06", "pFyeySzUjl0", "1:14"),
        new("promos",   "GwhcO3sguvw", "0:52", "VHmvhSuSo38", "0:57"),
        new("photo",    null,          null,   "IDm_50EGFVk", "1:09"),
    };

    private string Default => L.Culture == "ru" ? "ru" : "vi";
    private string Length(FilmInfo f) => Default == "ru" || f.Vi is null ? f.RuLength : f.ViLength!;

    // data-video is the Vietnamese cut (data-video-lang says so), data-video-ru the Russian one.
    private static Dictionary<string, object> Cuts(FilmInfo f) => f.Vi is null
        ? new() { ["data-video"] = f.Ru, ["data-video-lang"] = "ru" }
        : new() { ["data-video"] = f.Vi, ["data-video-lang"] = "vi", ["data-video-ru"] = f.Ru };

    // Every cut's length on the label, so site.js can swap it when the visitor changes language.
    private static Dictionary<string, object> Len(FilmInfo f) => f.Vi is null
        ? new() { ["data-len-ru"] = f.RuLength }
        : new() { ["data-len-vi"] = f.ViLength!, ["data-len-ru"] = f.RuLength };

    protected override void OnInitialized()
    {
        // Localized routes: /nails (en), /fr/nails, /vi/nails, /ru/nails.
        var seg = new Uri(Nav.Uri).AbsolutePath.Trim('/').Split('/').FirstOrDefault() ?? "";
        L.SetCulture(seg);
    }
}

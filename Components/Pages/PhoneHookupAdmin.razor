@page "/admin/phone-hookup"
@attribute [Authorize(Roles = AppAuthValidator.AdminRole)]
@rendermode InteractiveServer
@using MapleKiosk.Web.Assistant
@using MapleKiosk.Web.Assistant.Voice
@inject PhoneHookupTwilio Twilio

@*
    MapleKiosk's own phone line: which Twilio number rings the website's voice agent, whether it answers, and in
    which language it opens. "Connect" points the number's webhooks at this site (Assistant/Voice/Twilio/).
    Not the salon numbers sold on /phone-line — those ring each salon's own app.
*@

<PageTitle>Phone hookup — MapleKiosk</PageTitle>

<header class="onb-top">
    <div class="container onb-top__inner">
        <a href="/admin" class="onb-top__logo"><img src="/MapleKiosk_rectangle.png" alt="MapleKiosk" /></a>
        <span class="adm-title"><a href="/admin" style="color:inherit;text-decoration:none">Admin</a> / Phone hookup</span>
        <a href="/voice-test" class="btn btn-ghost onb-small adm-top__action">Voice test</a>
    </div>
</header>

<main class="adm">
    <div class="container adm__wrap">
        <p class="onb__muted">
            A Twilio number connected here is answered by the website's voice assistant (the one on /voice-test),
            on the phone. Every call shows on <a href="/chats">/chats</a> as “Phone call”, with the caller's number.
        </p>

        @if (_loading)
        {
            <p class="onb__muted">Loading…</p>
        }
        else
        {
            @if (!_hasGemini)
            {
                <p class="adm-banner">No Gemini API key: set it in <a href="/chats">/chats</a> → Settings, or calls are refused.</p>
            }

            <h2>Line</h2>
            <div class="adm-field">
                <span>Answering number</span>
                <strong>@(_setup.HasNumber ? _setup.Number : "None — connect one below")</strong>
            </div>
            <label class="adm-switch">
                <input type="checkbox" checked="@_setup.Enabled" disabled="@(_busy || !_setup.HasNumber)"
                       @onchange="SetEnabledAsync" />
                Answer calls (off: callers hear “we can't take your call” and the call ends)
            </label>
            <label>Opening language
                <select value="@_setup.Language" disabled="@_busy" @onchange="SetLanguageAsync">
                    @foreach (var lang in PhoneHookup.Languages)
                    {
                        <option value="@lang">@MapleKioskVoicePersona.Language(lang)</option>
                    }
                </select>
                <small>The greeting's language; the assistant follows the caller if they speak another.</small>
            </label>

            <h2>Numbers on the Twilio account</h2>
            @if (_error is not null) { <p class="onb-error">@_error</p> }
            @if (_numbers.Count == 0 && _error is null)
            {
                <p class="onb__muted">No numbers on the account. Buy one in the Twilio console, then reload.</p>
            }
            <ul class="adm-list">
                @foreach (var n in _numbers)
                {
                    <li>
                        <div class="adm-row">
                            <span class="adm-row__main">
                                <strong>@n.Number@(n.FriendlyName != "" && n.FriendlyName != n.Number ? $" · {n.FriendlyName}" : "")</strong>
                                <small>@(n.PointsHere ? "Rings this site's assistant" : n.IsFree ? "Not pointed anywhere" : $"Rings {Host(n.VoiceUrl)} — in use elsewhere")</small>
                            </span>
                            <span class="adm-row__side">
                                @if (n.PointsHere)
                                {
                                    <button type="button" class="btn btn-ghost onb-small" disabled="@_busy" @onclick="() => DisconnectAsync(n)">Disconnect</button>
                                }
                                else if (n.IsFree)
                                {
                                    <button type="button" class="btn btn-primary onb-small" disabled="@_busy" @onclick="() => ConnectAsync(n)">Connect</button>
                                }
                                else
                                {
                                    <small>Repoint it in the Twilio console first</small>
                                }
                            </span>
                        </div>
                    </li>
                }
            </ul>

            <h2>By hand</h2>
            <p class="onb__muted">To wire a number yourself (another account, a forward), set on the number in Twilio, all POST:</p>
            <div class="adm-field"><span>A call comes in</span><code>@PhoneHookup.IncomingUrl</code></div>
            <div class="adm-field"><span>Primary handler fails</span><code>@PhoneHookup.FallbackUrl</code></div>
            <div class="adm-field"><span>Call status changes</span><code>@PhoneHookup.StatusUrl</code></div>
            <p class="onb__muted">It must be a number on the platform account (Twilio/AccountSid) — its auth token checks the webhooks —
                and then picked above, or saved as the answering number, for calls to be taken.</p>
        }
        @if (_message is not null) { <p class="adm-banner adm-banner--ok">@_message</p> }
    </div>
</main>

@code {
    private bool _loading = true, _busy, _hasGemini;
    private PhoneHookupSetup _setup = new(false, "", "", "en");
    private IReadOnlyList<OwnedNumber> _numbers = [];
    private string? _error, _message;

    protected override async Task OnInitializedAsync()
    {
        _setup = await PhoneHookup.ReadAsync();
        _hasGemini = !string.IsNullOrWhiteSpace((await AssistantSettings.ResolveVoiceAsync()).GeminiApiKey);
        await LoadNumbersAsync();
        _loading = false;
    }

    private async Task LoadNumbersAsync() => (_numbers, _error) = await Twilio.ListAsync();

    private Task SetEnabledAsync(ChangeEventArgs e) => SaveAsync(_setup with { Enabled = e.Value is true });

    private Task SetLanguageAsync(ChangeEventArgs e) => SaveAsync(_setup with { Language = e.Value?.ToString() ?? "en" });

    private async Task SaveAsync(PhoneHookupSetup setup)
    {
        _busy = true; _message = null;
        try
        {
            await PhoneHookup.SaveAsync(setup);
            _setup = setup;
            _message = "Saved.";
        }
        catch (Exception ex) { _error = "Couldn't save: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConnectAsync(OwnedNumber n)
    {
        _busy = true; _message = null; _error = null;
        try
        {
            // One line: the number answering before stops ringing here.
            if (_setup.HasNumber && _setup.NumberSid != n.Sid && _numbers.FirstOrDefault(x => x.Sid == _setup.NumberSid) is { PointsHere: true } old)
            {
                _error = await Twilio.DisconnectAsync(old.Sid);
                if (_error is not null) return;
            }
            _error = await Twilio.ConnectAsync(n.Sid);
            if (_error is not null) return;

            await PhoneHookup.SaveAsync(_setup = new PhoneHookupSetup(true, n.Number, n.Sid, _setup.Language));
            _message = $"{n.Number} now rings the assistant. Call it to try.";
        }
        finally
        {
            await LoadNumbersAsync();
            _busy = false;
        }
    }

    private async Task DisconnectAsync(OwnedNumber n)
    {
        _busy = true; _message = null; _error = null;
        try
        {
            _error = await Twilio.DisconnectAsync(n.Sid);
            if (_error is not null) return;
            if (_setup.NumberSid == n.Sid || PhoneHookup.Digits(_setup.Number) == PhoneHookup.Digits(n.Number))
                await PhoneHookup.SaveAsync(_setup = new PhoneHookupSetup(false, "", "", _setup.Language));
            _message = $"{n.Number} no longer rings this site.";
        }
        finally
        {
            await LoadNumbersAsync();
            _busy = false;
        }
    }

    private static string Host(string url) => Uri.TryCreate(url, UriKind.Absolute, out var u) ? u.Host : url;
}

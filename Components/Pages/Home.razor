@page "/"
@page "/fr"
@page "/vi"
@page "/ru"
@inject LocalizationService L
@inject NavigationManager Nav
@inject CartService Cart

<PageTitle>@L["home.meta.title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["home.meta.desc"]" />
    <meta property="og:title" content="@L["home.meta.title"]" />
    <meta property="og:description" content="@L["home.meta.desc"]" />
    <meta property="og:url" content="@Nav.Uri" />
</HeadContent>

<NavBar />
<Hero />
<LogoStrip />
<IndustryInvites />
<Apps />
<AIServices />
<HowItWorks />
<DashboardPreview />
<Pricing />
@* <Faq /> — re-enable when there are real FAQ entries to show *@
<CtaBanner />
<TrialForm Culture="@L.Culture" />
<Footer />
<MobileCta />

@code {
    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var seg = uri.AbsolutePath.Trim('/').Split('/').FirstOrDefault() ?? "";
        L.SetCulture(seg);
    }
}

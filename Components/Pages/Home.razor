@page "/"
@page "/fr"
@page "/vi"
@page "/ru"
@inject LocalizationService L
@inject NavigationManager Nav

<PageTitle>@L["home.meta.title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["home.meta.desc"]" />
    <meta property="og:title" content="@L["home.meta.title"]" />
    <meta property="og:description" content="@L["home.meta.desc"]" />
    <meta property="og:url" content="@Nav.Uri" />
    <VideoSchema Ids="SchemaVideos" />
</HeadContent>

<NavBar />

<main class="hp">

    <!-- ===================== FOUR DOORS ===================== -->
    <section class="hp-doors" id="top">
        <div class="container">
            <h1 class="hp-doors__title">@L["hp.h1"]</h1>
            <p class="hp-doors__sub">@L["hp.sub"]</p>

            <div class="hp-doors__grid" id="trades">
                @foreach (var d in _doors)
                {
                    <article class="hp-door hp-door--@d.Key" id="@d.Key">
                        @if (d.VideoId is not null)
                        {
                            <button type="button" class="hp-door__media" @attributes="d.Cuts"
                                    aria-label="@($"{L["hp.watch"]}: {d.Product} ({d.Length})")">
                                <img src="img/home/@d.Image" alt="@L[$"hp.alt.{d.Key}"]" loading="@(d.Key == "coffee" ? "eager" : "lazy")" width="1280" height="720" />
                                <span class="hp-play" aria-hidden="true"></span>
                                <span class="hp-len" @attributes="d.Lens">@d.Length</span>
                                @if (d.Vietnamese)
                                {
                                    <span class="hp-tag">@L["hp.narrated.vi"]</span>
                                }
                            </button>
                        }
                        else
                        {
                            <div class="hp-door__media hp-door__media--soon" aria-hidden="true">
                                <span>@L["hp.soon"]</span>
                            </div>
                        }
                        <div class="hp-door__body">
                            <p class="hp-door__trade">@L[$"hp.{d.Key}.trade"] <span>· @d.Product</span></p>
                            <p class="hp-door__line">@L[$"hp.{d.Key}.line"]</p>
                            <div class="hp-door__actions">
                                @if (d.VideoId is not null)
                                {
                                    <button type="button" class="hp-link" @attributes="d.Cuts">@L["hp.watch"] <span @attributes="d.Lens">@d.Length</span></button>
                                }
                                @if (d.Page is not null)
                                {
                                    <a class="hp-link hp-link--strong" href="@Localized(d.Page)">@L[$"hp.{d.Key}.more"] <span aria-hidden="true">→</span></a>
                                }
                                else if (d.VideoId is not null)
                                {
                                    <span class="hp-door__note">@L[$"hp.{d.Key}.page"]</span>
                                }
                                else
                                {
                                    <a class="hp-link hp-link--strong" href="javascript:void(0)" data-open-trial>@L[$"hp.{d.Key}.cta"]</a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <!-- ===================== AI, AS A JOB ===================== -->
    <section class="hp-ai">
        <div class="container">
            <h2 class="hp-h2">@L["hp.ai.title"]</h2>
            <p class="hp-lead">@L["hp.ai.sub"]</p>
            <div class="hp-ai__grid">
                <figure class="hp-ai__item">
                    <button type="button" class="hp-door__media" data-video="G5uLNWY26ds" aria-label="@($"{L["hp.watch"]}: MapleCoffee (1:15)")">
                        <img src="img/home/coffee-voice-kiosk.jpg" alt="@L["hp.alt.voice"]" loading="lazy" width="1280" height="720" />
                        <span class="hp-play" aria-hidden="true"></span>
                        <span class="hp-len">1:15</span>
                    </button>
                    <figcaption>
                        <blockquote>@L["hp.ai.coffee.quote"]</blockquote>
                        <p>@L["hp.ai.coffee.text"]</p>
                    </figcaption>
                </figure>
                <figure class="hp-ai__item">
                    <button type="button" class="hp-door__media" data-video="n1Src-4w5MY" aria-label="@($"{L["hp.watch"]}: MapleSPA (1:21)")">
                        <img src="img/home/nails-ai-receptionist.jpg" alt="@L["hp.alt.phone"]" loading="lazy" width="1280" height="720" />
                        <span class="hp-play" aria-hidden="true"></span>
                        <span class="hp-len">1:21</span>
                        <span class="hp-tag">@L["hp.narrated.vi"]</span>
                    </button>
                    <figcaption>
                        <blockquote>@L["hp.ai.nails.quote"]</blockquote>
                        <p>@L["hp.ai.nails.text"]</p>
                    </figcaption>
                </figure>
            </div>
            <p class="hp-ai__more"><a class="hp-link hp-link--strong" href="@Localized("/ai-agent")">@L["hp.ai.more"] <span aria-hidden="true">→</span></a></p>
        </div>
    </section>

    <!-- ===================== WHO WE ARE ===================== -->
    <section class="hp-co">
        <div class="container hp-co__grid">
            <div>
                <h2 class="hp-h2">@L["hp.co.title"]</h2>
                <p class="hp-lead">@L["hp.co.text"]</p>
            </div>
            <ul class="hp-co__facts">
                <li>@L["hp.co.place"]</li>
                <li>@L["hp.co.langs"]</li>
                <li>@L["hp.co.email"]: <a data-user="sales" data-domain="maplekiosk.ca">sales [at] maplekiosk.ca</a></li>
                <li><a href="https://www.youtube.com/@@ericngo2228" target="_blank" rel="noopener">@L["hp.co.videos"] →</a></li>
            </ul>
        </div>
    </section>

    <!-- ===================== CLOSE ===================== -->
    <section class="hp-end">
        <div class="container">
            <h2 class="hp-h2">@L["hp.end.title"]</h2>
            <div class="hp-end__actions">
                <a class="btn btn-primary" href="javascript:void(0)" data-open-trial>@L["nav.cta"]</a>
                <span>@L["hp.end.or"] <a data-user="sales" data-domain="maplekiosk.ca">sales [at] maplekiosk.ca</a></span>
            </div>
        </div>
    </section>

</main>

<TrialForm Culture="@L.Culture" />
<Footer />
<MobileCta />

@code {
    // The films as search engines see them (VideoSchema): each door's cut in this page's language,
    // else its default cut, plus the two AI films.
    private IEnumerable<string?> SchemaVideos =>
        [.. _doors.Select(d => (d.Cuts?.GetValueOrDefault($"data-video-{L.Culture}") ?? d.VideoId) as string),
         "G5uLNWY26ds", "n1Src-4w5MY"];

    // One door per trade, each playing its trade's overview film: the one at the top of the trade's own
    // page (so the two can't drift apart), except the garage, whose homepage film is its animated overview.
    // Cuts = the lightbox's data-video* attributes: the default cut, plus other languages the visitor can
    // switch to. Lens = each cut's length (data-len-*), so site.js labels the one that will play.
    private record Door(string Key, string Product, Dictionary<string, object>? Cuts, Dictionary<string, object>? Lens,
        string? Image, string? Length, string? Page, bool Vietnamese = false)
    {
        public string? VideoId => Cuts?["data-video"] as string;
    }

    // "MapleGarage Anime Overview" on the Maple Kiosk channel, English and French.
    private const string GarageAnimeEn = "9zb8QVRBdgg", GarageAnimeFr = "lcFLmIvngU4";

    private readonly Door[] _doors =
    {
        new("coffee", "MapleCoffee",
            new() { ["data-video"] = Coffee.Overview.Id },
            null,
            "coffee-morning-rush.jpg", Coffee.Overview.Length, "/coffee"),
        new("nails",  "MapleSPA",
            new() { ["data-video"] = Nails.Overview.Vi!, ["data-video-lang"] = "vi", ["data-video-ru"] = Nails.Overview.Ru },
            new() { ["data-len-vi"] = Nails.Overview.ViLength!, ["data-len-ru"] = Nails.Overview.RuLength },
            "nails-turn-board.jpg", Nails.Overview.ViLength, "/nails", Vietnamese: true),
        new("garage", "MapleGarage",
            new() { ["data-video"] = GarageAnimeEn, ["data-video-fr"] = GarageAnimeFr },
            new() { ["data-len-en"] = "1:32", ["data-len-fr"] = "1:43" },
            "garage-my-jobs.jpg", "1:32", "/garage"),
        new("resto",  "MaplePOS",
            new() { ["data-video"] = Restaurant.Overview.En, ["data-video-fr"] = Restaurant.Overview.Fr },
            new() { ["data-len-en"] = Restaurant.Overview.EnLength, ["data-len-fr"] = Restaurant.Overview.FrLength },
            "resto-floor.jpg", Restaurant.Overview.EnLength, "/restaurants"),
    };

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var seg = uri.AbsolutePath.Trim('/').Split('/').FirstOrDefault() ?? "";
        L.SetCulture(seg);
    }

    // Locale-aware internal link (/nails -> /fr/nails, ...).
    private string Localized(string path) => L.Culture == "en" ? path : $"/{L.Culture}{path}";
}

@page "/shop"
@page "/fr/shop"
@page "/vi/shop"
@page "/ru/shop"
@using MapleKiosk.Web.Shop.Catalog
@inject LocalizationService L
@inject NavigationManager Nav
@inject CatalogStore Catalog

@* The public storefront: anyone can browse, fill the cart and check out (no sign-in; only /shop/admin
   is gated). It sells the whole catalog (/shop/admin) as a compact list, one block per category; a row
   opens in place to show what's included (site.js, data-sh-toggle). The cart sits beside it (site.js,
   data-shop): one-time items are charged once, plans become a Stripe subscription. *@

<PageTitle>@L["shop.meta.title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["shop.meta.desc"]" />
    <meta property="og:title" content="@L["shop.meta.title"]" />
    <meta property="og:description" content="@L["shop.meta.desc"]" />
    <meta property="og:url" content="@Nav.Uri" />
</HeadContent>

<NavBar />

<main class="sh">
    <div class="container sh__grid">

        <div class="sh__main">
            <header class="sh__head">
                <h1 class="sh__title">@L["shop.crumb"]</h1>
                <p class="sh__note">@L["shop.note"]</p>
            </header>

            @if (_shop.Count == 0)
            {
                <p class="sh__empty">@L["shop.empty"]</p>
            }
            @foreach (var (cat, items) in _shop)
            {
                <section class="sh-cat" id="cat-@cat.Key" aria-labelledby="sh-g-@cat.Key">
                    <h2 class="sh-cat__title" id="sh-g-@cat.Key">
                        @cat.NameIn(L.Culture)
                        @if (cat.PickOne)
                        {
                            <small>@L["shop.pickone"]</small>
                        }
                    </h2>
                    <ul class="sh-list">
                        @foreach (var i in items)
                        {
                            var points = Points(i);
                            <li class="sh-item" id="item-@i.Sku">
                                @* Items with details open and close in place; the rest are a plain row. *@
                                @if (points.Count > 0)
                                {
                                    <button type="button" class="sh-item__info" data-sh-toggle aria-expanded="false" aria-controls="item-@i.Sku-more">
                                        @ItemHead(i)
                                    </button>
                                }
                                else
                                {
                                    <div class="sh-item__info">@ItemHead(i)</div>
                                }
                                <p class="sh-item__price">@Money(i.Price)<small>@Per(i)</small></p>
                                <button type="button" class="sh-add" data-shop-add="@i.Sku" data-name="@i.NameIn(L.Culture)"
                                        data-price="@i.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-interval="@i.BillingInterval" data-trial="@i.TrialDays" data-group="@cat.Key"
                                        data-pickone="@(cat.PickOne ? "1" : null)" data-recurring="@(BillingIntervals.IsRecurring(i.BillingInterval) ? "1" : null)">
                                    @(cat.PickOne && BillingIntervals.IsRecurring(i.BillingInterval) ? L["shop.choose"] : L["shop.add"])
                                </button>
                                @if (points.Count > 0)
                                {
                                    <div class="sh-item__more" id="item-@i.Sku-more" hidden>
                                        <ul class="sh-checks">
                                            @foreach (var pt in points) { <li>@pt</li> }
                                        </ul>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>

        @* The cart lives in the browser (site.js, data-shop): adding, quantities and totals answer at once,
           and only Checkout goes to the server (/api/checkout/shop), which prices everything again. *@
        <aside class="sh-cart" id="cart" aria-labelledby="shop-cart-title" data-shop
               data-culture="@L.Culture" data-locale="@Locale"
               data-t-add="@L["shop.add"]" data-t-choose="@L["shop.choose"]" data-t-added="@L["shop.added"]" data-t-remove="@L["shop.remove"]"
               data-t-empty="@L["cart.empty"]" data-t-less="@L["cart.less"]" data-t-more="@L["cart.more"]" data-t-each="@L["cart.each"]"
               data-t-today="@L["cart.today"]" data-t-then="@L["cart.then"]" data-t-aftertrial="@L["cart.aftertrial"]"
               data-t-renew="@L["cart.renew"]" data-t-mixed="@L["cart.mixed"]" data-t-email="@L["cart.email"]"
               data-t-checkout="@L["cart.checkout"]" data-t-wait="@L["cart.wait"]" data-t-secure="@L["cart.secure"]"
               data-t-cancelled="@L["cart.cancelled"]" data-t-fail="@L["cart.fail"]" data-t-needemail="@L["cart.needemail"]"
               data-t-view="@L["cart.view"]" data-t-items="@L["cart.items"]" data-t-month="@L["pr.month"]" data-t-year="@L["pr.year"]">
            <h2 class="sh-cart__title" id="shop-cart-title">@L["cart.title"]</h2>
            <div data-shop-body aria-live="polite">
                <p class="shop-cart__empty">@L["cart.empty"]</p>
            </div>
            @* For visitors still deciding: the demo form opens in place (TrialForm below). *@
            <p class="sh-cart__demo">@L["cart.demo"] <a href="javascript:void(0)" data-open-trial>@L["cart.demo.link"]</a></p>
        </aside>
        <a class="sh-bar" href="@($"{(L.Culture == "en" ? "" : L.Culture + "/")}shop#cart")" data-shop-bar hidden></a>
    </div>
</main>

<TrialForm Culture="@L.Culture" />
<Footer />

@code {
    private IReadOnlyList<(CatalogCategory Category, IReadOnlyList<AppProduct> Items)> _shop = [];

    protected override async Task OnInitializedAsync()
    {
        // Localized routes: /shop (en), /fr/shop, /vi/shop, /ru/shop.
        var seg = new Uri(Nav.Uri).AbsolutePath.Trim('/').Split('/').FirstOrDefault() ?? "";
        L.SetCulture(seg);
        _shop = await Catalog.GetGroupsAsync();
    }

    // Everything the visitor reads is in their language where the catalog has it (/shop/admin), else English.
    private string? Blurb(AppProduct i) => i.DescriptionIn(L.Culture) is { Length: > 0 } d && !string.IsNullOrWhiteSpace(d) ? d : null;

    // The cart formats amounts like the pricing pages (Intl, in site.js).
    private string Locale => L.Culture switch { "fr" => "fr-CA", "vi" => "vi-VN", "ru" => "ru-RU", _ => "en-CA" };

    private string Per(AppProduct i) => i.BillingInterval switch
    {
        BillingIntervals.Monthly => " " + L["pr.month"],
        BillingIntervals.Yearly => " " + L["pr.year"],
        _ => "",
    };

    // The row's picture, name, tags and one-line description (inside the toggle button, so only phrasing content).
    private RenderFragment ItemHead(AppProduct i) => @<text>
        @if (!string.IsNullOrWhiteSpace(i.ImageUrl))
        {
            <img class="sh-item__img" src="@i.ImageUrl" alt="" width="64" height="64" loading="lazy" />
        }
        <span class="sh-item__name">
            @i.NameIn(L.Culture)
            @if (i.Recommended)
            {
                <span class="sh-tag">@L["pr.rec"]</span>
            }
            @if (i.TrialDays > 0 && BillingIntervals.IsRecurring(i.BillingInterval))
            {
                <span class="sh-tag sh-tag--trial">@string.Format(L["shop.trial"], i.TrialDays)</span>
            }
            @if (Points(i).Count > 0)
            {
                <span class="sh-item__chev" aria-hidden="true"></span>
            }
        </span>
        @if (Blurb(i) is { } blurb)
        {
            <span class="sh-item__desc">@blurb</span>
        }
    </text>;

    // What's included: the item's Details lines (/shop/admin), else its features.
    private List<string> Points(AppProduct i)
    {
        var lines = (i.DetailsIn(L.Culture) ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        return lines.Count > 0 ? lines : i.Features;
    }

    private string Money(decimal d) => ShopMoney.Format(d, L.Culture);
}

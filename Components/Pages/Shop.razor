@page "/shop"

@* Public storefront: anyone can browse, fill the cart and check out (no sign-in; only /shop/admin is
   gated). Lives in the site rather than MapleShop.UI so it wears the site's header and footer. *@

<PageTitle>Shop — MapleKiosk</PageTitle>
<HeadContent>
    <meta name="description" content="Buy MapleKiosk apps and plans online. Pay by card; monthly plans renew automatically and can be cancelled any time." />
</HeadContent>

<NavBar />

<main class="lp">
    <section class="section" id="shop">
        <div class="container">
            <h1 style="font-size:clamp(28px,4vw,44px);text-align:center">Shop</h1>
            <p style="color:var(--muted);text-align:center;max-width:520px;margin:12px auto 28px">
                Pick the apps you want. Add them to your cart and check out by card.
                Monthly plans renew automatically — cancel any time.
            </p>
            <ProductCatalog />
        </div>
    </section>
</main>

<Footer />

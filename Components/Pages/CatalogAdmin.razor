@page "/shop/admin"
@attribute [Authorize(Roles = AppAuthValidator.AdminRole)]
@* Not prerendered: an admin page has nothing to show search engines, and it loads once instead of twice. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using MapleKiosk.Web.Shop.Catalog
@using MapleKiosk.Web.Shop.Config
@using MapleKiosk.Web.Shop.Payments
@inject CatalogStore Store
@inject BlobImageUploader Uploader
@inject StripeProductSync Stripe
@inject AppStoreConfig Config
@inject NavigationManager Nav
@inject CatalogTranslator Translator

@* The catalog: everything the site sells, in one place, sold on the trades' pricing pages and in the
   shop. Categories group the items; each item has a price and how often it's charged. Saving an item
   syncs it to Stripe (Product + Price, in English); deleting it archives it there. Names and wording
   can also be kept in French, Vietnamese and Russian, for the website only. *@

<PageTitle>Catalog — MapleKiosk</PageTitle>

<section class="section">
    <div class="container" style="max-width:1100px">
        <h1 style="font-size:clamp(26px,3vw,40px)">Catalog</h1>
        <p style="color:var(--muted)">
            Products and services, their price (@CatalogStore.Currency) and how often they're charged. The pricing pages, the shop,
            checkout and the website assistant all read this. Saving an item syncs it to Stripe.
        </p>

        <div class="cat-actions" style="align-items:center">
            <span class="stp-mode stp-mode--@_mode.ToLowerInvariant().Replace(' ', '-')">Stripe: @_mode</span>
            <button class="btn btn-ghost" disabled="@(_busy || _mode == "not configured")" @onclick="SyncAll">Sync all to Stripe</button>
            @if (_progress is not null) { <span style="color:var(--muted)">@_progress</span> }
        </div>
        @if (!Store.IsConfigured)
        {
            <p class="mshop-error">Catalog storage is not configured (STORAGE_CONNECTION_STRING): showing the defaults, read-only.</p>
        }
        @if (_mode == "not configured")
        {
            <p class="mshop-error">No Stripe key: set AppStore/StripeSecretKey in the keyvalue table (or APPSTORE_STRIPE_SECRET_KEY). Items save without syncing.</p>
        }
        @if (_notice is not null) { <p class="cat-notice">@_notice</p> }
        @if (_error is not null) { <p class="mshop-error">@_error</p> }

        <!-- Items, by category: tap a row to edit; + Add in the title -->
        @foreach (var c in _categories)
        {
            var items = _items.Where(i => i.Category == c.Key).ToList();
            <div class="cat-card">
                <div class="cat-head">
                    <h3>@c.Name <small class="cat-sub">@(c.PickOne ? "pick one" : "pick any")</small></h3>
                    <button class="btn btn-ghost cat-add" disabled="@(!Store.IsConfigured)" @onclick="() => NewItem(c.Key)">+ Add</button>
                </div>
                @if (items.Count == 0)
                {
                    <p style="color:var(--muted)">No items yet.</p>
                }
                else
                {
                    <table class="cat-table">
                        <thead><tr><th>Item</th><th>Price</th><th>Stripe</th></tr></thead>
                        <tbody>
                            @foreach (var i in items) { @ItemRow(i) }
                        </tbody>
                    </table>
                }
            </div>
        }
        @{ var loose = _items.Where(i => _categories.All(c => c.Key != i.Category)).ToList(); }
        @if (loose.Count > 0)
        {
            <div class="cat-card">
                <h3>No category <small class="cat-sub">not sold anywhere until you give them one</small></h3>
                <table class="cat-table"><tbody>@foreach (var i in loose) { @ItemRow(i) }</tbody></table>
            </div>
        }

        <!-- Categories -->
        <div class="cat-card">
            <div class="cat-head">
                <h3>Categories</h3>
                <button class="btn btn-ghost cat-add" disabled="@(!Store.IsConfigured)" @onclick="NewCategory">+ Add</button>
            </div>
            <table class="cat-table">
                <thead><tr><th>Name</th><th>Key</th><th>Buyers</th><th>Order</th></tr></thead>
                <tbody>
                    @foreach (var c in _categories)
                    {
                        <tr class="cat-click" @onclick="() => EditCategory(c)">
                            <td>@c.Name</td>
                            <td><code>@c.Key</code></td>
                            <td>@(c.PickOne ? "Pick one" : "Pick any")</td>
                            <td>@c.Sort</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@* ---- Item dialog ---- *@
@if (_itemOpen)
{
    var st = _isNew ? null : _stripe.GetValueOrDefault(_edit.Sku);
    <div class="adm-scrim" @onclick="CloseItem"></div>
    <div class="adm-sheet adm-sheet--wide" role="dialog" aria-label="Item">
        <h2>@(_isNew ? "Add item" : _edit.Name)</h2>
        <div class="cat-grid">
            <label>Category
                <select @bind="_edit.Category">
                    <option value="">— pick —</option>
                    @foreach (var c in _categories) { <option value="@c.Key">@c.Name</option> }
                </select>
            </label>
            <label>SKU
                <input @bind="_edit.Sku" disabled="@(!_isNew)" placeholder="@(_edit.Category is { Length: > 0 } ? _edit.Category + "-name" : "item-name")" />
            </label>
            <div class="cat-words" style="grid-column:1/-1">
                <div class="cat-tabs" role="tablist">
                    @foreach (var lang in Langs)
                    {
                        <button type="button" role="tab" class="cat-tab @(_lang == lang ? "is-on" : null)" aria-selected="@(_lang == lang)"
                                @onclick="() => _lang = lang">
                            @CatalogLanguages.NameOf(lang)
                            @if (lang != "en") { <span class="cat-tab__state cat-tab__state--@TextState(_edit, lang)" title="@TextStateLabel(_edit, lang)"></span> }
                        </button>
                    }
                    <button type="button" class="btn btn-ghost cat-translate" disabled="@(_translating || string.IsNullOrWhiteSpace(_edit.Name))" @onclick="TranslateItem">
                        @(_translating ? "Translating…" : "Translate from English")
                    </button>
                </div>
                @if (_lang == "en")
                {
                    <label>Name
                        <input @bind="_edit.Name" placeholder="What it's called on Stripe, receipts and the shop" />
                    </label>
                    <label>Description
                        <input @bind="_edit.Description" placeholder="One line" />
                    </label>
                    <label>Details <small class="cat-sub">what's included, one point per line · shown when a shop item is opened</small>
                        <textarea rows="5" @bind="_edit.Details" placeholder="@DetailsPlaceholder"></textarea>
                    </label>
                }
                else
                {
                    var t = TextFor(_edit, _lang);
                    <p class="cat-hint">Shown on the website only — Stripe, invoices and the customer portal use the English name. Empty fields show the English.</p>
                    @if (TextState(_edit, _lang) == "stale")
                    {
                        <p class="cat-warn">The English has changed since this was translated. Check it, or press “Translate from English”.</p>
                    }
                    <label>Name
                        <input @bind="t.Name" placeholder="@_edit.Name" />
                    </label>
                    <label>Description
                        <input @bind="t.Description" placeholder="@_edit.Description" />
                    </label>
                    <label>Details <small class="cat-sub">same points as the English, one per line</small>
                        <textarea rows="5" @bind="t.Details" placeholder="@_edit.Details"></textarea>
                    </label>
                    <button type="button" class="btn btn-ghost cat-checked" @onclick="() => t.Source = CatalogText.SourceOf(_edit)"
                            hidden="@(TextState(_edit, _lang) != "stale")">Mark as checked</button>
                }
            </div>
            <label>Price (@CatalogStore.Currency)
                <input type="number" min="0" step="0.01" @bind="_edit.Price" />
            </label>
            <label>Charged
                <select @bind="_edit.BillingInterval">
                    <option value="@BillingIntervals.OneTime">One time</option>
                    <option value="@BillingIntervals.Monthly">Every month</option>
                    <option value="@BillingIntervals.Yearly">Every year</option>
                </select>
            </label>
            <label>Order in its category
                <input type="number" step="1" @bind="_edit.Sort" />
            </label>
            <label>Free trial (days, shop only)
                <input type="number" min="0" step="1" @bind="_edit.TrialDays" />
            </label>
            <label style="grid-column:1/-1">Features (one per line)
                <textarea rows="3" @bind="_featuresText" placeholder="@FeaturesPlaceholder"></textarea>
            </label>
            <label>VND price (VietQR, shop only)
                <input type="number" min="0" step="1" @bind="_edit.PriceVnd" />
            </label>
            <div class="cat-image" style="grid-column:1/-1">
                <span class="cat-image__label">Image <small class="cat-sub">JPG, PNG or WebP, up to 5 MB · shown in the shop and on Stripe</small></span>
                <div class="cat-image__row">
                    @if (!string.IsNullOrWhiteSpace(_edit.ImageUrl))
                    {
                        <img class="cat-image__preview" src="@_edit.ImageUrl" alt="" />
                    }
                    else
                    {
                        <span class="cat-image__preview cat-image__preview--none">No image</span>
                    }
                    <div class="cat-image__actions">
                        <label class="btn btn-ghost cat-image__pick">
                            @(_uploading ? "Uploading…" : string.IsNullOrWhiteSpace(_edit.ImageUrl) ? "Choose image" : "Replace")
                            <InputFile OnChange="OnImageSelected" accept="image/jpeg,image/png,image/webp" disabled="@(_uploading || !Uploader.IsConfigured)" />
                        </label>
                        @if (!string.IsNullOrWhiteSpace(_edit.ImageUrl) && !_uploading)
                        {
                            <button class="btn btn-ghost" @onclick="() => _edit.ImageUrl = null">Remove</button>
                        }
                    </div>
                </div>
            </div>
            <label class="cat-check"><input type="checkbox" @bind="_edit.Active" /> Active (for sale)</label>
            <label class="cat-check"><input type="checkbox" @bind="_edit.Recommended" /> Recommended</label>
        </div>
        @if (st?.ProductId is not null)
        {
            <p class="cat-hint">
                Stripe: <span class="stp-state stp-state--@st.State.ToString().ToLowerInvariant()">@Label(st.State)</span>
                <a href="@($"https://dashboard.stripe.com/{(_mode == "test" ? "test/" : "")}products/{st.ProductId}")" target="_blank" rel="noopener">open in Stripe ↗</a>
            </p>
        }
        @if (_error is not null) { <p class="mshop-error">@_error</p> }
        <div class="adm-sheet__actions">
            @if (!_isNew)
            {
                <button class="btn btn-ghost cat-del" style="margin-right:auto" disabled="@(_busy || !Store.IsConfigured)" @onclick="() => DeleteItem()">
                    @(_confirmDelete ? "Delete — sure?" : "Delete")
                </button>
            }
            <button class="btn btn-ghost" @onclick="CloseItem">Cancel</button>
            <button class="btn btn-primary" disabled="@(_busy || _uploading || !Store.IsConfigured)" @onclick="Save">@(_busy ? "Saving…" : _isNew ? "Add" : "Save")</button>
        </div>
    </div>
}

@* ---- Category dialog ---- *@
@if (_catOpen)
{
    <div class="adm-scrim" @onclick="CloseCategory"></div>
    <div class="adm-sheet" role="dialog" aria-label="Category">
        <h2>@(_catIsNew ? "Add category" : _cat.Name)</h2>
        <div class="cat-grid">
            <label>Name <input @bind="_cat.Name" placeholder="Hardware" /></label>
            <label>Key <input @bind="_cat.Key" disabled="@(!_catIsNew)" placeholder="hardware" /></label>
            <label>Order <input type="number" step="1" @bind="_cat.Sort" /></label>
            @foreach (var lang in CatalogLanguages.Translated)
            {
                var l = lang;
                <label>@CatalogLanguages.NameOf(l)
                    <input value="@_cat.Names.GetValueOrDefault(l)" @onchange="e => _cat.Names[l] = e.Value?.ToString()?.Trim() ?? string.Empty" placeholder="@_cat.Name" />
                </label>
            }
            <div style="grid-column:1/-1">
                <button type="button" class="btn btn-ghost cat-translate" disabled="@(_translating || string.IsNullOrWhiteSpace(_cat.Name))" @onclick="TranslateCategory">
                    @(_translating ? "Translating…" : "Translate from English")
                </button>
                <small class="cat-sub">Translated names show on the website only.</small>
            </div>
            <label class="cat-check" style="grid-column:1/-1"><input type="checkbox" @bind="_cat.PickOne" /> Buyers pick one (plans), not any number (add-ons)</label>
        </div>
        @if (_error is not null) { <p class="mshop-error">@_error</p> }
        <div class="adm-sheet__actions">
            @if (!_catIsNew)
            {
                <button class="btn btn-ghost cat-del" style="margin-right:auto" disabled="@(_busy || !Store.IsConfigured)" @onclick="DeleteCategory">
                    @(_confirmDelete ? "Delete — sure?" : "Delete")
                </button>
            }
            <button class="btn btn-ghost" @onclick="CloseCategory">Cancel</button>
            <button class="btn btn-primary" disabled="@(_busy || !Store.IsConfigured)" @onclick="SaveCategory">@(_catIsNew ? "Add" : "Save")</button>
        </div>
    </div>
}

@code {
    private const string DetailsPlaceholder = "Installed and set up by our team\nWorks offline when the internet drops";
    private const string FeaturesPlaceholder = "Unlimited invoices\nPriority support";

    private IReadOnlyList<CatalogCategory> _categories = [];
    private IReadOnlyList<AppProduct> _items = [];
    private Dictionary<string, StripeItemStatus> _stripe = new();
    private string _mode = "…";

    private static readonly string[] Langs = ["en", .. CatalogLanguages.Translated];

    private AppProduct _edit = new() { Active = true };
    private string _lang = "en";
    private bool _translating;
    private string _featuresText = "";
    private bool _isNew = true;
    private bool _itemOpen;
    private CatalogCategory _cat = new();
    private bool _catIsNew = true;
    private bool _catOpen;
    private bool _confirmDelete;

    private bool _busy;
    private bool _uploading;
    private string? _progress;
    private string? _notice;
    private string? _error;

    private bool _stripeLoading;

    // The catalog first (from memory, instant), then where each item stands in Stripe (a few API calls).
    protected override async Task OnInitializedAsync() => await ReloadCatalogAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ReloadStripeAsync();
        StateHasChanged();
    }

    private RenderFragment ItemRow(AppProduct i) => __builder =>
    {
        var st = _stripe.GetValueOrDefault(i.Sku);
        <tr class="cat-click @(i.Active ? null : "cat-off")" @onclick="() => Edit(i)">
            <td class="cat-item">
                @if (!string.IsNullOrWhiteSpace(i.ImageUrl)) { <img class="cat-thumb" src="@i.ImageUrl" alt="" loading="lazy" /> }
                else { <span class="cat-thumb cat-thumb--none"></span> }
                <span><strong>@i.Name</strong>@(i.Recommended ? " ★" : "")<br /><small class="cat-sub"><code>@i.Sku</code>@(i.Active ? "" : " · not for sale")@TranslationNote(i)</small></span>
            </td>
            <td>$@i.Price.ToString("0.00") <small class="cat-sub">@Every(i)@(i.TrialDays > 0 ? $" · {i.TrialDays}-day trial" : "")</small></td>
            <td>
                @if (st is null && _stripeLoading)
                {
                    <small class="cat-sub">checking…</small>
                }
                else if (st is not null)
                {
                    <span class="stp-state stp-state--@st.State.ToString().ToLowerInvariant()">@Label(st.State)</span>
                    @if (st.Detail is not null) { <br /><small class="cat-sub">@st.Detail</small> }
                }
            </td>
        </tr>
    };

    private async Task ReloadAsync()
    {
        await ReloadCatalogAsync();
        await ReloadStripeAsync();
    }

    private async Task ReloadCatalogAsync()
    {
        try
        {
            _categories = await Store.GetCategoriesAsync();
            _items = await Store.GetAllAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ReloadStripeAsync()
    {
        _stripeLoading = true;
        try
        {
            var key = await Config.GetStripeSecretKeyAsync();
            _mode = string.IsNullOrEmpty(key) ? "not configured" : key.Contains("_live_") ? "live" : "test";
            _stripe = (await Stripe.GetStatusAsync(_items.Select(i => StripeItem.From(i, Nav.BaseUri)).ToList())).ToDictionary(s => s.Item.Sku);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _stripeLoading = false; }
    }

    // --- Items ---

    private void NewItem(string category)
    {
        _edit = new AppProduct { Active = true, Category = category, BillingInterval = BillingIntervals.Monthly };
        _featuresText = "";
        _isNew = true;
        OpenItem();
    }

    private void OpenItem()
    {
        _lang = "en";
        _notice = _error = null;
        _confirmDelete = false;
        _itemOpen = true;
    }

    private void CloseItem() { _itemOpen = false; _error = null; }

    private void Edit(AppProduct p)
    {
        _edit = new AppProduct
        {
            Sku = p.Sku, Category = p.Category, Name = p.Name, Description = p.Description, Details = p.Details, Price = p.Price,
            PriceVnd = p.PriceVnd, ImageUrl = p.ImageUrl, Active = p.Active, BillingInterval = p.BillingInterval,
            TrialDays = p.TrialDays, Sort = p.Sort, Recommended = p.Recommended, Features = new List<string>(p.Features),
            Texts = p.Texts.ToDictionary(t => t.Key, t => new CatalogText
                { Name = t.Value.Name, Description = t.Value.Description, Details = t.Value.Details, Source = t.Value.Source })
        };
        _featuresText = string.Join("\n", p.Features);
        _isNew = false;
        OpenItem();
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        if (!BlobImageUploader.IsSupported(e.File.ContentType)) { _error = "Use a JPG, PNG or WebP image."; return; }
        if (e.File.Size > BlobImageUploader.MaxBytes) { _error = "That image is over 5 MB."; return; }
        _uploading = true;
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(BlobImageUploader.MaxBytes).CopyToAsync(ms);
            ms.Position = 0;
            _edit.ImageUrl = await Uploader.UploadAsync(ms, e.File.ContentType);
        }
        catch (Exception ex) { _error = $"Image upload failed: {ex.Message}"; }
        finally { _uploading = false; }
    }

    private async Task Save()
    {
        _notice = _error = null;
        if (string.IsNullOrEmpty(_edit.Category)) { _error = "Pick a category."; return; }
        if (!CatalogStore.IsValidSku(_edit.Sku)) { _error = "SKU must be 1–64 chars: letters, digits, dash or underscore."; return; }
        if (_isNew && _items.Any(i => i.Sku == _edit.Sku)) { _error = $"There's already an item “{_edit.Sku}”."; return; }
        if (string.IsNullOrWhiteSpace(_edit.Name)) { _error = "Name is required."; return; }
        if (_edit.Price < 0) { _error = "Price can't be negative."; return; }

        _edit.Features = _featuresText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

        _busy = true;
        try
        {
            await Store.UpsertAsync(_edit);
            _notice = $"Saved “{_edit.Name}”." + await SyncAsync(_edit);
            _itemOpen = false;
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // First tap asks, second deletes.
    private async Task DeleteItem()
    {
        if (!_confirmDelete) { _confirmDelete = true; return; }
        var p = _items.FirstOrDefault(i => i.Sku == _edit.Sku);
        if (p is null) { _itemOpen = false; return; }
        _notice = _error = null;
        _busy = true;
        try
        {
            // Archive in Stripe first (Stripe keeps products that have sold; live subscriptions carry on).
            var archived = new AppProduct { Sku = p.Sku, Name = p.Name, Price = p.Price, BillingInterval = p.BillingInterval, ImageUrl = p.ImageUrl, Active = false };
            var stripe = await SyncAsync(archived);
            await Store.DeleteAsync(p.Sku);
            _itemOpen = false;
            _notice = $"Deleted “{p.Name}”." + stripe;
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // " Synced to Stripe." / a Stripe error / nothing when Stripe isn't set up.
    private async Task<string> SyncAsync(AppProduct p)
    {
        if (!await Stripe.IsConfiguredAsync()) return "";
        var r = await Stripe.SyncAsync(StripeItem.From(p, Nav.BaseUri));
        return r.Success ? (p.Active ? " Synced to Stripe." : " Archived in Stripe.") : $" Stripe sync failed: {r.Error}";
    }

    private async Task SyncAll()
    {
        _notice = _error = null;
        _busy = true;
        var todo = _stripe.Values.Where(s => s.State is StripeSyncState.Missing or StripeSyncState.Outdated).Select(s => s.Item).ToList();
        var errors = new List<string>();
        for (var n = 0; n < todo.Count; n++)
        {
            _progress = $"Syncing {n + 1} / {todo.Count}…";
            StateHasChanged();
            var r = await Stripe.SyncAsync(todo[n]);
            if (!r.Success) errors.Add($"{todo[n].Name}: {r.Error}");
        }
        _progress = null;
        _notice = todo.Count == 0 ? "Everything is already in sync." : $"Synced {todo.Count - errors.Count} of {todo.Count}.";
        if (errors.Count > 0) _error = string.Join(" · ", errors);
        await ReloadAsync();
        _busy = false;
    }

    // --- Categories ---

    private void NewCategory()
    {
        _cat = new CatalogCategory();
        _catIsNew = true;
        OpenCategory();
    }

    private void OpenCategory()
    {
        _notice = _error = null;
        _confirmDelete = false;
        _catOpen = true;
    }

    private void CloseCategory() { _catOpen = false; _error = null; }

    private void EditCategory(CatalogCategory c)
    {
        _cat = new CatalogCategory { Key = c.Key, Name = c.Name, PickOne = c.PickOne, Sort = c.Sort, Names = new(c.Names) };
        _catIsNew = false;
        OpenCategory();
    }

    private async Task SaveCategory()
    {
        _notice = _error = null;
        if (string.IsNullOrWhiteSpace(_cat.Name)) { _error = "Category name is required."; return; }
        if (_catIsNew && _categories.Any(c => c.Key == _cat.Key)) { _error = $"There's already a category “{_cat.Key}”."; return; }
        try
        {
            await Store.UpsertCategoryAsync(_cat);
            _notice = $"Saved category “{_cat.Name}”.";
            _catOpen = false;
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DeleteCategory()
    {
        if (!_confirmDelete) { _confirmDelete = true; return; }
        _notice = _error = null;
        try
        {
            await Store.DeleteCategoryAsync(_cat.Key);
            _notice = $"Deleted category “{_cat.Name}”.";
            _catOpen = false;
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // --- Translations (website only; Stripe keeps the English) ---

    // The dialog's working copy of one language, created on first use; empty ones aren't saved.
    private static CatalogText TextFor(AppProduct p, string lang)
    {
        if (!p.Texts.TryGetValue(lang, out var t)) p.Texts[lang] = t = new CatalogText { Source = CatalogText.SourceOf(p) };
        return t;
    }

    // "none" (not translated), "stale" (the English changed since), or "ok".
    private static string TextState(AppProduct p, string lang)
    {
        if (!p.Texts.TryGetValue(lang, out var t) || t.IsEmpty) return "none";
        return t.Source == CatalogText.SourceOf(p) ? "ok" : "stale";
    }

    private static string TextStateLabel(AppProduct p, string lang) => TextState(p, lang) switch
    {
        "none" => "Not translated (shows the English)",
        "stale" => "The English changed since this was translated",
        _ => "Translated",
    };

    private static string TranslationNote(AppProduct i)
    {
        var states = CatalogLanguages.Translated.Select(l => TextState(i, l)).ToList();
        if (states.All(s => s == "ok")) return "";
        if (states.All(s => s == "none")) return " · not translated";
        return states.Contains("stale") ? " · translation out of date" : " · partly translated";
    }

    private async Task TranslateItem()
    {
        _error = null;
        _translating = true;
        try
        {
            var r = await Translator.TranslateAsync(_edit);
            if (r.Texts is null) { _error = r.Error; return; }
            foreach (var (lang, text) in r.Texts) _edit.Texts[lang] = text;
            if (_lang == "en") _lang = CatalogLanguages.Translated[0];
            _notice = "Translations drafted. Check them, then Save.";
        }
        finally { _translating = false; }
    }

    private async Task TranslateCategory()
    {
        _error = null;
        _translating = true;
        try
        {
            var (names, error) = await Translator.TranslateNameAsync(_cat.Name);
            if (names is null) { _error = error; return; }
            _cat.Names = names;
        }
        finally { _translating = false; }
    }

    private static string Every(AppProduct i) => i.BillingInterval switch
    {
        BillingIntervals.Monthly => "/ month",
        BillingIntervals.Yearly => "/ year",
        _ => "one time",
    };

    private static string Label(StripeSyncState s) => s switch
    {
        StripeSyncState.InSync => "In sync",
        StripeSyncState.Missing => "Not in Stripe",
        StripeSyncState.Outdated => "Out of date",
        StripeSyncState.Archived => "Archived",
        _ => "",
    };
}

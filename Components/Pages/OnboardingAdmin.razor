@page "/onboarding/admin"
@attribute [Authorize(Roles = AppAuthValidator.AdminRole)]
@rendermode InteractiveServer
@inject OnboardingStore Store
@inject OnboardingService Service
@inject DemoLinkStore Demos
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Customers — MapleKiosk</PageTitle>

<header class="onb-top">
    <div class="container onb-top__inner">
        <a href="/" class="onb-top__logo"><img src="/MapleKiosk_rectangle.png" alt="MapleKiosk" /></a>
        <span class="adm-title">Customers</span>
        <button type="button" class="btn btn-ghost onb-small adm-top__action" @onclick="OpenDemos">Demo links</button>
    </div>
</header>

<main class="adm">
    <div class="container adm__wrap">
        @if (!Store.IsConfigured)
        {
            <p class="onb-error">Storage is not configured (STORAGE_CONNECTION_STRING).</p>
        }

        @if (_records.Count > 0)
        {
            <input class="adm-search" type="search" placeholder="Search customers" @bind="_query" @bind:event="oninput" />
        }

        @if (_loading)
        {
            <p class="onb__muted">Loading…</p>
        }
        else if (_records.Count == 0)
        {
            <div class="adm-empty">
                <p><strong>No customers yet</strong></p>
                <p class="onb__muted">Tap <b>+</b> to add one after their deposit.</p>
            </div>
        }
        else
        {
            @if (_showArchived)
            {
                <p class="adm-view"><button type="button" class="adm-link" @onclick="() => _showArchived = false">← Customers</button> <strong>Archived</strong></p>
            }
            <ul class="adm-list">
                @foreach (var r in Filtered)
                {
                    <li>
                        <button type="button" class="adm-row" @onclick="() => Open(r)">
                            <span class="adm-avatar">@Initial(r)</span>
                            <span class="adm-row__main">
                                <strong>@r.Form.BusinessName</strong>
                                <small>@r.ContactEmail · @OnboardingIndustries.Label(r.Industry)@(r.IncludesWebsite ? " · Website" : "")</small>
                            </span>
                            <span class="adm-row__side">
                                @if (r.Access == OnboardingAccess.Active)
                                {
                                    <span class="onb-status onb-status--@r.Status.ToString().ToLowerInvariant()">@StatusLabel(r.Status)</span>
                                }
                                else
                                {
                                    <span class="onb-status adm-access--@r.Access.ToString().ToLowerInvariant()">@r.Access</span>
                                }
                                <small>@Ago(r.SubmittedAt ?? r.UpdatedAt ?? r.CreatedAt)</small>
                            </span>
                        </button>
                    </li>
                }
            </ul>
            @if (!_showArchived && ArchivedCount > 0)
            {
                <p class="adm-view"><button type="button" class="adm-link" @onclick="() => _showArchived = true">Archived (@ArchivedCount) →</button></p>
            }
        }
    </div>
</main>

<button type="button" class="adm-fab" aria-label="Add customer" @onclick="OpenAdd">+</button>

@* ---- Add customer ---- *@
@if (_adding)
{
    <div class="adm-scrim" @onclick="() => _adding = false"></div>
    <div class="adm-sheet" role="dialog" aria-label="Add customer">
        <h2>Add customer</h2>
        <div class="adm-form">
            <label>Business name
                <input @bind="_name" placeholder="Lily Nails & Spa" />
            </label>
            <label>Login email
                <input type="email" @bind="_email" placeholder="owner@gmail.com" />
                <small>The Google or Microsoft account they'll sign in with.</small>
            </label>
            <div class="adm-field">
                <span>Industry</span>
                <div class="wb-chips">
                    @foreach (var (id, label) in OnboardingIndustries.All)
                    {
                        <button type="button" class="wb-chip @(_industry == id ? "is-on" : "")" @onclick="() => _industry = id">@label</button>
                    }
                </div>
            </div>
            <div class="adm-field">
                <span>Language</span>
                <div class="wb-chips">
                    @foreach (var (code, label) in Languages)
                    {
                        <button type="button" class="wb-chip @(_language == code ? "is-on" : "")" @onclick="() => _language = code">@label</button>
                    }
                </div>
            </div>
            <label class="adm-switch"><input type="checkbox" @bind="_includesWebsite" /> Includes a website</label>
            <label class="adm-switch"><input type="checkbox" @bind="_sendEmail" /> Email them an invitation</label>
        </div>
        @if (_error is not null) { <p class="onb-error">@_error</p> }
        <div class="adm-sheet__actions">
            <button type="button" class="btn btn-ghost" @onclick="() => _adding = false">Cancel</button>
            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="Create">@(_busy ? "Adding…" : "Add")</button>
        </div>
    </div>
}

@* ---- Demo links (the welcome email of a "Book a demo" request links the chosen product's demo) ---- *@
@if (_demos is not null)
{
    <div class="adm-scrim" @onclick="() => _demos = null"></div>
    <div class="adm-sheet adm-sheet--wide" role="dialog" aria-label="Demo links">
        <h2>Demo links</h2>
        <p class="onb__muted">Sent in the welcome email when someone books a demo, by the business type they pick. Leave the link empty to send no demo link.</p>
        <div class="adm-form">
            @foreach (var d in _demos)
            {
                <div class="adm-field adm-demo">
                    <span>@d.Label</span>
                    <span class="adm-demo__row">
                        <input @bind="d.Product" placeholder="Product" aria-label="@($"{d.Label} product")" />
                        <input type="url" @bind="d.Url" placeholder="https://…" aria-label="@($"{d.Label} demo link")" />
                    </span>
                </div>
            }
        </div>
        @if (_demoError is not null) { <p class="onb-error">@_demoError</p> }
        <div class="adm-sheet__actions">
            <button type="button" class="btn btn-ghost" @onclick="() => _demos = null">Cancel</button>
            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SaveDemos">@(_busy ? "Saving…" : "Save")</button>
        </div>
    </div>
}

@* ---- Customer details ---- *@
@if (_current is { } c)
{
    <div class="adm-scrim" @onclick="Close"></div>
    <aside class="adm-drawer" role="dialog" aria-label="@c.Form.BusinessName">
        <div class="adm-drawer__head">
            <div>
                <h2>@c.Form.BusinessName</h2>
                <span class="onb-status onb-status--@c.Status.ToString().ToLowerInvariant()">@StatusLabel(c.Status)</span>
            </div>
            <button type="button" class="adm-close" aria-label="Close" @onclick="Close">✕</button>
        </div>

        <div class="adm-actions">
            <button type="button" class="btn btn-ghost onb-small" @onclick="() => CopyLink(c)">@(_note == "copied" ? "Copied ✓" : "Copy link")</button>
            @* No invite for a suspended or archived customer — they can't open the page. *@
            @if (c.Access == OnboardingAccess.Active && c.Status != OnboardingStatus.Submitted)
            {
                <button type="button" class="btn btn-ghost onb-small" @onclick="() => Resend(c)">@(_note == "resent" ? "Sent ✓" : "Resend invite")</button>
            }
            else if (c.Status == OnboardingStatus.Submitted)
            {
                <button type="button" class="btn btn-ghost onb-small" @onclick="() => Reopen(c)">Reopen for edits</button>
            }
            <a class="btn btn-ghost onb-small" href="/onboarding/@c.Token" target="_blank">View as customer ↗</a>
        </div>

        @if (c.Access != OnboardingAccess.Active)
        {
            <p class="adm-banner">
                <strong>@c.Access</strong>@(c.AccessChangedAt is { } at ? $" on {at.ToLocalTime():yyyy-MM-dd}" : "") — the customer can't open their setup page or files.
            </p>
        }

        <div class="adm-form">
            <div class="adm-field">
                <span>Owner email</span>
                <small>The Google or Microsoft account that signs in to this setup.</small>
                <span class="adm-inline">
                    <input type="email" @bind="_editEmail" @bind:event="oninput" aria-label="Owner email" />
                    @if (OnboardingRecord.CanonicalEmail(_editEmail) != c.ContactEmail && !_confirmEmail)
                    {
                        <button type="button" class="btn btn-primary onb-small" @onclick="AskEmailChange">Change</button>
                    }
                </span>
                @if (_confirmEmail)
                {
                    <div class="adm-confirm">
                        <p>Move this setup to <b>@OnboardingRecord.CanonicalEmail(_editEmail)</b>? <b>@c.ContactEmail</b> will lose access.</p>
                        <label class="adm-switch"><input type="checkbox" @bind="_inviteNewOwner" /> Email the new owner an invitation</label>
                        <span class="adm-inline">
                            <button type="button" class="btn btn-ghost onb-small" @onclick="CancelEmailChange">Cancel</button>
                            <button type="button" class="btn btn-primary onb-small" disabled="@_busy" @onclick="() => SaveEmail(c)">Move access</button>
                        </span>
                    </div>
                }
                @if (_emailError is not null) { <p class="onb-error">@_emailError</p> }
            </div>
            <label class="adm-switch"><input type="checkbox" checked="@c.IncludesWebsite" @onchange="e => SetIncludesWebsite(c, e)" /> Includes a website</label>
        </div>

        <div class="adm-field adm-access">
            <span>Access</span>
            <span class="adm-inline">
                @if (c.Access == OnboardingAccess.Active)
                {
                    <button type="button" class="btn btn-ghost onb-small" disabled="@_busy" @onclick="() => SetAccess(c, OnboardingAccess.Suspended)">Suspend</button>
                    <button type="button" class="btn btn-ghost onb-small" disabled="@_busy" @onclick="() => SetAccess(c, OnboardingAccess.Archived)">Archive</button>
                }
                else if (c.Access == OnboardingAccess.Suspended)
                {
                    <button type="button" class="btn btn-primary onb-small" disabled="@_busy" @onclick="() => SetAccess(c, OnboardingAccess.Active)">Resume access</button>
                    <button type="button" class="btn btn-ghost onb-small" disabled="@_busy" @onclick="() => SetAccess(c, OnboardingAccess.Archived)">Archive</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary onb-small" disabled="@_busy" @onclick="() => SetAccess(c, OnboardingAccess.Active)">Restore</button>
                }
            </span>
            <small>Suspend: they can still sign in but see "paused". Archive: also hidden from this list and no sign-in. Nothing is deleted.</small>
        </div>

        <div class="adm-summary">
            @((MarkupString)OnboardingService.SummaryHtml(c, f => $"/onboarding/files/{c.Token}/{f.Id}"))
        </div>
        @if (c.IncludesWebsite && _brief is not null)
        {
            <div class="adm-summary">
                <h2 style="margin:0 0 4px">Website brief</h2>
                @((MarkupString)OnboardingService.BriefHtml(c, _brief, f => $"/onboarding/files/{c.Token}/{f.Id}"))
            </div>
        }
    </aside>
}

@code {
    private static readonly (string Code, string Label)[] Languages = [("en", "English"), ("fr", "Français"), ("vi", "Tiếng Việt")];

    private List<OnboardingRecord> _records = new();
    private bool _loading = true;
    private bool _busy;
    private string _query = "";

    // Add sheet
    private bool _adding;
    private string? _error;
    private string _name = "";
    private string _email = "";
    private string _industry = OnboardingIndustries.Nails;
    private string _language = "en";
    private bool _sendEmail = true;
    private bool _includesWebsite;

    // Details drawer
    private OnboardingRecord? _current;
    private WebsiteBrief? _brief;
    private string _editEmail = "";
    private string? _note;
    private bool _confirmEmail;
    private bool _inviteNewOwner = true;
    private string? _emailError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _records = (await Store.GetAllAsync()).ToList();
        _loading = false;
    }

    private bool _showArchived;
    private int ArchivedCount => _records.Count(r => r.Access == OnboardingAccess.Archived);

    private IEnumerable<OnboardingRecord> Filtered =>
        _records
            .Where(r => (r.Access == OnboardingAccess.Archived) == _showArchived)
            .Where(r => string.IsNullOrWhiteSpace(_query)
                        || r.Form.BusinessName.Contains(_query, StringComparison.OrdinalIgnoreCase)
                        || r.ContactEmail.Contains(_query, StringComparison.OrdinalIgnoreCase));

    private static string Initial(OnboardingRecord r) =>
        string.IsNullOrWhiteSpace(r.Form.BusinessName) ? "?" : r.Form.BusinessName.Trim()[..1].ToUpperInvariant();

    private static string StatusLabel(OnboardingStatus s) => s switch
    {
        OnboardingStatus.Sent => "Not started",
        OnboardingStatus.InProgress => "In progress",
        _ => "Submitted"
    };

    private static string Ago(DateTimeOffset at)
    {
        var d = DateTimeOffset.UtcNow - at;
        return d.TotalMinutes < 1 ? "just now"
            : d.TotalHours < 1 ? $"{(int)d.TotalMinutes} min ago"
            : d.TotalDays < 1 ? $"{(int)d.TotalHours} h ago"
            : d.TotalDays < 30 ? $"{(int)d.TotalDays} d ago"
            : at.ToLocalTime().ToString("yyyy-MM-dd");
    }

    private void OpenAdd()
    {
        _error = null;
        _adding = true;
    }

    private async Task Create()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Enter the business name."; return; }
        if (!_email.Contains('@')) { _error = "Enter the email they'll sign in with."; return; }

        _busy = true;
        try
        {
            var r = await Service.CreateAsync(_name, _email, _industry, _language, null, _includesWebsite, _sendEmail, Nav.BaseUri);
            _name = _email = "";
            _includesWebsite = false;
            _adding = false;
            await ReloadAsync();
            await Open(_records.FirstOrDefault(x => x.Token == r.Token) ?? r);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Open(OnboardingRecord r)
    {
        _current = r;
        _editEmail = r.ContactEmail;
        _note = null;
        _confirmEmail = false;
        _emailError = null;
        _brief = r.IncludesWebsite ? await Store.GetBriefAsync(r.Token) : null;
    }

    private void Close() => _current = null;

    // Demo links sheet
    private sealed class DemoRow { public string Type = "", Label = "", Product = "", Url = ""; }
    private List<DemoRow>? _demos;
    private string? _demoError;

    private async Task OpenDemos()
    {
        _demoError = Demos.IsConfigured ? null : "Storage is not configured (STORAGE_CONNECTION_STRING).";
        var links = await Demos.GetAllAsync();
        _demos = links
            .Select(l => new DemoRow
            {
                Type = l.BusinessType,
                Label = DemoLinkStore.BusinessTypes.First(t => t.Type == l.BusinessType).Label,
                Product = l.Product,
                Url = l.Url
            })
            .ToList();
    }

    private async Task SaveDemos()
    {
        if (_demos is null) return;
        _demoError = null;
        var links = new List<DemoLink>();
        foreach (var d in _demos)
        {
            if (DemoLinkStore.NormalizeUrl(d.Url) is not { } url) { _demoError = $"{d.Label}: the link isn't a web address."; return; }
            links.Add(new DemoLink(d.Type, string.IsNullOrWhiteSpace(d.Product) ? "MapleKiosk" : d.Product, url));
        }
        _busy = true;
        try
        {
            await Demos.SaveAsync(links);
            _demos = null;
        }
        catch (Exception ex) { _demoError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SetIncludesWebsite(OnboardingRecord r, ChangeEventArgs e)
    {
        r.IncludesWebsite = e.Value is true;
        await Store.SaveAsync(r);
        _brief = r.IncludesWebsite ? await Store.GetBriefAsync(r.Token) : null;
    }

    private void AskEmailChange()
    {
        var email = OnboardingRecord.CanonicalEmail(_editEmail);
        _emailError = email.Length < 3 || email.IndexOf('@') is < 1 || email.Contains(' ') || email.EndsWith('@')
            ? "Enter a full email address." : null;
        _confirmEmail = _emailError is null;
    }

    private void CancelEmailChange()
    {
        _confirmEmail = false;
        _emailError = null;
        _editEmail = _current?.ContactEmail ?? "";
    }

    // The owner email is the customer's access — changing it moves access to the new account
    // (the old one loses it at once: every page load and save re-checks the email).
    private async Task SaveEmail(OnboardingRecord r)
    {
        _busy = true;
        try
        {
            r.ContactEmail = OnboardingRecord.CanonicalEmail(_editEmail);
            _editEmail = r.ContactEmail;
            await Store.SaveAsync(r);
            if (_inviteNewOwner && r.Access == OnboardingAccess.Active) await Service.SendInviteAsync(r, Nav.BaseUri);
            _confirmEmail = false;
            _emailError = null;
        }
        catch (Exception ex) { _emailError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SetAccess(OnboardingRecord r, OnboardingAccess access)
    {
        _busy = true;
        try
        {
            r.Access = access;
            r.AccessChangedAt = DateTimeOffset.UtcNow;
            await Store.SaveAsync(r);
            if (access == OnboardingAccess.Archived) _current = null; // it leaves the list
        }
        finally { _busy = false; }
    }

    private async Task CopyLink(OnboardingRecord r)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", OnboardingService.CustomerUrl(Nav.BaseUri, r));
        _note = "copied";
    }

    private async Task Resend(OnboardingRecord r)
    {
        await Service.SendInviteAsync(r, Nav.BaseUri);
        _note = "resent";
    }

    private async Task Reopen(OnboardingRecord r)
    {
        r.Status = OnboardingStatus.InProgress;
        r.SubmittedAt = null;
        await Store.SaveAsync(r);
    }
}

@page "/onboarding/admin"
@attribute [Authorize(Roles = AppAuthValidator.AdminRole)]
@rendermode InteractiveServer
@inject OnboardingStore Store
@inject OnboardingService Service
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Customer onboarding — MapleKiosk</PageTitle>

<section class="section">
    <div class="container" style="max-width:1100px">
        <h1 style="font-size:clamp(26px,3vw,40px)">Customer onboarding</h1>
        <p style="color:var(--muted)">After a deposit, add the customer's email here. They sign in at <code>/onboarding</code> with Google or Microsoft using that email, fill in business details, hours and access, and upload the filled template. You get an email when they submit.</p>

        @if (!Store.IsConfigured)
        {
            <p class="onb-error">Onboarding storage is not configured (STORAGE_CONNECTION_STRING).</p>
        }

        <div class="onb-card">
            <h2 style="font-size:18px;margin:0 0 14px">Add customer</h2>
            <div class="onb-grid">
                <label><span>Business name <em>*</em></span>
                    <input @bind="_name" placeholder="Lily Nails & Spa" />
                </label>
                <label><span>Customer login email <em>*</em></span>
                    <input type="email" @bind="_email" placeholder="owner@gmail.com" />
                    <small>The Google or Microsoft account they will sign in with.</small>
                </label>
                <label>Industry
                    <select @bind="_industry">
                        @foreach (var (id, label) in OnboardingIndustries.All)
                        {
                            <option value="@id">@label</option>
                        }
                    </select>
                </label>
                <label>Customer language
                    <select @bind="_language">
                        <option value="en">English</option>
                        <option value="fr">Français</option>
                        <option value="vi">Tiếng Việt</option>
                    </select>
                </label>
                <label>Deposit / order ref (optional)
                    <input @bind="_orderRef" placeholder="MK2610021530A1B2" />
                </label>
                <label class="onb-check" style="align-self:end">
                    <input type="checkbox" @bind="_includesWebsite" /> Scope includes a website (adds the website brief)
                </label>
                <label class="onb-check" style="align-self:end">
                    <input type="checkbox" @bind="_sendEmail" /> Email the customer an invitation
                </label>
            </div>
            @if (_error is not null) { <p class="onb-error">@_error</p> }
            <div style="margin-top:16px">
                <button class="btn btn-primary" disabled="@_busy" @onclick="Create">@(_busy ? "Adding…" : "Add customer")</button>
            </div>
        </div>

        @if (_loading)
        {
            <p style="color:var(--muted)">Loading…</p>
        }
        else if (_records.Count == 0)
        {
            <p style="color:var(--muted)">No onboarding links yet.</p>
        }
        else
        {
            <div class="onb-filter">
                @foreach (var s in new[] { "All", "Sent", "InProgress", "Submitted" })
                {
                    <button class="onb-pill @(_filter == s ? "is-on" : "")" @onclick="() => _filter = s">
                        @StatusLabel(s) <span>@Count(s)</span>
                    </button>
                }
            </div>
            <table class="onb-table">
                <thead>
                    <tr><th>Business</th><th>Industry</th><th>Status</th><th>Created</th><th>Submitted</th><th>Files</th><th>Website</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Filtered)
                    {
                        <tr class="@(_open == r.Token ? "is-open" : "")">
                            <td><strong>@r.Form.BusinessName</strong><br /><small style="color:var(--muted)">@r.ContactEmail</small></td>
                            <td>@OnboardingIndustries.Label(r.Industry) · @r.Language.ToUpperInvariant()</td>
                            <td><span class="onb-status onb-status--@r.Status.ToString().ToLowerInvariant()">@StatusLabel(r.Status.ToString())</span></td>
                            <td>@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td>@(r.SubmittedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "—")</td>
                            <td>@r.Files.Count</td>
                            <td>@(r.IncludesWebsite ? "Yes" : "—")</td>
                            <td class="onb-actions">
                                <button class="btn btn-ghost onb-small" @onclick="() => Toggle(r)">@(_open == r.Token ? "Close" : "View")</button>
                                <button class="btn btn-ghost onb-small" @onclick="() => CopyLink(r)">@(_copied == r.Token ? "Copied ✓" : "Copy link")</button>
                            </td>
                        </tr>
                        @if (_open == r.Token)
                        {
                            <tr class="onb-detail">
                                <td colspan="8">
                                    <div class="onb-detail__body">
                                        @((MarkupString)OnboardingService.SummaryHtml(r, f => $"/onboarding/files/{r.Token}/{f.Id}"))
                                    </div>
                                    <label class="onb-check" style="margin-top:12px">
                                        <input type="checkbox" checked="@r.IncludesWebsite" @onchange="e => SetIncludesWebsite(r, e)" /> Scope includes a website
                                    </label>
                                    @if (r.IncludesWebsite && _openBrief is not null)
                                    {
                                        <div class="onb-detail__body" style="margin-top:12px">
                                            <h2 style="margin:0 0 4px">Website brief</h2>
                                            @((MarkupString)OnboardingService.BriefHtml(r, _openBrief, f => $"/onboarding/files/{r.Token}/{f.Id}"))
                                        </div>
                                    }
                                    <div class="onb-grid" style="max-width:520px">
                                        <label>Login email
                                            <span style="display:flex;gap:8px">
                                                <input type="email" @bind="_editEmail" />
                                                <button class="btn btn-ghost onb-small" @onclick="() => SaveEmail(r)">Save</button>
                                            </span>
                                        </label>
                                    </div>
                                    <div class="onb-actions" style="margin-top:12px">
                                        <a class="btn btn-ghost onb-small" href="@OnboardingService.CustomerUrl(Nav.BaseUri, r)" target="_blank">Open customer page</a>
                                        @if (!string.IsNullOrWhiteSpace(r.ContactEmail) && r.Status != OnboardingStatus.Submitted)
                                        {
                                            <button class="btn btn-ghost onb-small" @onclick="() => Resend(r)">@(_resent == r.Token ? "Sent ✓" : "Resend email")</button>
                                        }
                                        @if (r.Status == OnboardingStatus.Submitted)
                                        {
                                            <button class="btn btn-ghost onb-small" @onclick="() => Reopen(r)">Reopen for edits</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
</section>

@code {
    private List<OnboardingRecord> _records = new();
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string _filter = "All";
    private string? _open;
    private string? _copied;
    private string? _resent;

    private string _name = "";
    private string _email = "";
    private string _industry = OnboardingIndustries.Nails;
    private string _language = "en";
    private string _orderRef = "";
    private bool _sendEmail = true;
    private bool _includesWebsite;
    private WebsiteBrief? _openBrief;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _records = (await Store.GetAllAsync()).ToList();
        _loading = false;
    }

    private IEnumerable<OnboardingRecord> Filtered =>
        _filter == "All" ? _records : _records.Where(r => r.Status.ToString() == _filter);

    private int Count(string s) => s == "All" ? _records.Count : _records.Count(r => r.Status.ToString() == s);

    private static string StatusLabel(string s) => s switch
    {
        "Sent" => "Not started",
        "InProgress" => "In progress",
        _ => s
    };

    private async Task Create()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Business name is required."; return; }
        if (!_email.Contains('@')) { _error = "Enter the email the customer will sign in with."; return; }

        _busy = true;
        try
        {
            var r = await Service.CreateAsync(_name, _email, _industry, _language, _orderRef, _includesWebsite, _sendEmail, Nav.BaseUri);
            _name = _email = _orderRef = "";
            await ReloadAsync();
            _open = r.Token;
            _editEmail = r.ContactEmail;
            _openBrief = r.IncludesWebsite ? new WebsiteBrief() : null;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private string _editEmail = "";

    private async Task Toggle(OnboardingRecord r)
    {
        _open = _open == r.Token ? null : r.Token;
        _editEmail = r.ContactEmail;
        _openBrief = _open is not null && r.IncludesWebsite ? await Store.GetBriefAsync(r.Token) : null;
    }

    private async Task SetIncludesWebsite(OnboardingRecord r, ChangeEventArgs e)
    {
        r.IncludesWebsite = e.Value is true;
        await Store.SaveAsync(r);
        _openBrief = r.IncludesWebsite ? await Store.GetBriefAsync(r.Token) : null;
    }

    // The login email is the customer's access — changing it moves access to the new account.
    private async Task SaveEmail(OnboardingRecord r)
    {
        if (!_editEmail.Contains('@')) return;
        r.ContactEmail = OnboardingRecord.CanonicalEmail(_editEmail);
        await Store.SaveAsync(r);
    }

    private async Task CopyLink(OnboardingRecord r)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", OnboardingService.CustomerUrl(Nav.BaseUri, r));
        _copied = r.Token;
    }

    private async Task Resend(OnboardingRecord r)
    {
        await Service.SendInviteAsync(r, Nav.BaseUri);
        _resent = r.Token;
    }

    private async Task Reopen(OnboardingRecord r)
    {
        r.Status = OnboardingStatus.InProgress;
        r.SubmittedAt = null;
        await Store.SaveAsync(r);
    }
}

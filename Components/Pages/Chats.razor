@page "/chats"
@attribute [Authorize(Roles = AppAuthValidator.AdminRole)]
@rendermode InteractiveServer
@implements IDisposable
@using MapleKiosk.Web.Assistant
@using MapleKiosk.Web.Assistant.Voice
@inject ChatLog Log
@inject NavigationManager Nav

<PageTitle>Chats — MapleKiosk</PageTitle>

<header class="onb-top">
    <div class="container onb-top__inner">
        <a href="/" class="onb-top__logo"><img src="/MapleKiosk_rectangle.png" alt="MapleKiosk" /></a>
        <span class="adm-title"><a href="/admin" style="color:inherit;text-decoration:none">Admin</a> / Chats</span>
        <a href="/admin/assistant" class="btn btn-ghost onb-small adm-top__action">Settings</a>
    </div>
</header>

<main class="adm">
    <div class="container adm__wrap">
        @if (!Log.IsConfigured)
        {
            <p class="onb-error">The data folder can't be written — conversations are not being recorded.</p>
        }

        <div class="cht-bar">
            <input class="adm-search" type="search" placeholder="Search name, contact or words" @bind="_query" @bind:event="oninput" />
            <div class="wb-chips">
                <button type="button" class="wb-chip @(_filter == "all" ? "is-on" : "")" @onclick="@(() => _filter = "all")">All (@_list.Count)</button>
                <button type="button" class="wb-chip @(_filter == "leads" ? "is-on" : "")" @onclick="@(() => _filter = "leads")">With contact (@_list.Count(c => c.Contact is not null))</button>
                <button type="button" class="wb-chip @(_filter == "live" ? "is-on" : "")" @onclick="@(() => _filter = "live")">Live now (@_list.Count(IsLive))</button>
                @foreach (var ch in ChatChannel.All)
                {
                    var n = _list.Count(c => ChatChannel.Of(c) == ch);
                    if (n == 0) continue;
                    <button type="button" class="wb-chip @(_filter == ch ? "is-on" : "")" @onclick="@(() => _filter = ch)">@ChatChannel.Icon(ch) @ChatChannel.Label(ch) (@n)</button>
                }
            </div>
        </div>

        @if (_loading)
        {
            <p class="onb__muted">Loading…</p>
        }
        else if (!Filtered.Any())
        {
            <div class="adm-empty">
                <p><strong>No conversations @(_filter == "all" && string.IsNullOrWhiteSpace(_query) ? "in the last 30 days" : "match")</strong></p>
                <p class="onb__muted">Every chat with the assistant on the website shows up here as it happens.</p>
            </div>
        }
        else
        {
            <ul class="adm-list">
                @foreach (var c in Filtered)
                {
                    <li>
                        <a class="adm-row" href="/chats/@c.Id">
                            <span class="adm-avatar @(c.Contact is not null ? "cht-avatar--lead" : "")">@Initial(c)</span>
                            <span class="adm-row__main">
                                <strong>
                                    <span class="cht-tag cht-tag--@ChatChannel.Of(c)">@ChatChannel.Icon(ChatChannel.Of(c)) @ChatChannel.Label(ChatChannel.Of(c))</span>
                                    @(c.Contact?.Name ?? "Guest")@(c.Contact?.Business is { } b ? $" · {b}" : "")
                                </strong>
                                <small>@c.Preview</small>
                            </span>
                            <span class="adm-row__side">
                                @if (IsLive(c))
                                {
                                    <span class="cht-live">Live</span>
                                }
                                else if (c.TakenMessages.Count > 0)
                                {
                                    <span class="onb-status onb-status--done">@(c.TakenMessages.Any(m => m.Urgent) ? "Urgent message" : "Message")</span>
                                }
                                else if (c.Contact is not null)
                                {
                                    <span class="onb-status onb-status--done">Contact</span>
                                }
                                <small>@c.Lang.ToUpperInvariant() · @c.Messages msgs · @Ago(c.LastAt)</small>
                            </span>
                        </a>
                    </li>
                }
            </ul>
            <p class="onb__muted cht-note">Last 30 days · refreshes every few seconds.</p>
        }
    </div>
</main>

@code {
    private static readonly TimeSpan Refresh = TimeSpan.FromSeconds(5);
    private static readonly TimeSpan LiveWindow = TimeSpan.FromMinutes(3);

    private List<ChatConversation> _list = new();
    private bool _loading = true;
    private string _query = "";
    private string _filter = "all";

    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    private IEnumerable<ChatConversation> Filtered => _list
        .Where(c => _filter switch { "leads" => c.Contact is not null, "live" => IsLive(c), "all" => true, var ch => ChatChannel.Of(c) == ch })
        .Where(c => string.IsNullOrWhiteSpace(_query) || Matches(c, _query.Trim()));

    private static bool Matches(ChatConversation c, string q) =>
        new[] { c.Preview, c.Contact?.Name, c.Contact?.Phone, c.Contact?.Email, c.Contact?.Business, c.Contact?.Interest, c.FirstPage }
            .Any(v => v?.Contains(q, StringComparison.OrdinalIgnoreCase) == true);

    private static bool IsLive(ChatConversation c) => DateTimeOffset.UtcNow - c.LastAt < LiveWindow;

    protected override async Task OnInitializedAsync()
    {
        // Old links (the lead email) say /chats?c={id}: send them to the conversation's page.
        var id = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["c"];
        if (!string.IsNullOrWhiteSpace(id)) { Nav.NavigateTo($"/chats/{Uri.EscapeDataString(id)}", replace: true); return; }
        await LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _timer = new PeriodicTimer(Refresh);
        _ = TickAsync(_cts.Token);
    }

    // Live: reload the list every few seconds while the page is open.
    private async Task TickAsync(CancellationToken ct)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(ct))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task LoadAsync()
    {
        try { _list = await Log.ListAsync(30); }
        catch { /* keep the last list; storage hiccups shouldn't blank the page */ }
        _loading = false;
    }

    private static string Initial(ChatConversation c) =>
        c.Contact?.Name is { Length: > 0 } n ? n[..1].ToUpperInvariant() : "?";

    private static string Ago(DateTimeOffset at)
    {
        var d = DateTimeOffset.UtcNow - at;
        return d.TotalMinutes < 1 ? "just now"
             : d.TotalHours < 1 ? $"{(int)d.TotalMinutes} min ago"
             : d.TotalDays < 1 ? $"{(int)d.TotalHours} h ago"
             : d.TotalDays < 7 ? $"{(int)d.TotalDays} d ago"
             : at.ToLocalTime().ToString("MMM d");
    }

    public void Dispose()
    {
        _cts.Cancel();
        _timer?.Dispose();
        _timer = null;
        _cts.Dispose();
    }
}

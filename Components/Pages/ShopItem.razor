@page "/shop/{Sku}"
@page "/fr/shop/{Sku}"
@page "/vi/shop/{Sku}"
@page "/ru/shop/{Sku}"
@using MapleKiosk.Web.Shop.Catalog
@inject LocalizationService L
@inject NavigationManager Nav
@inject CatalogStore Catalog

@* One product of the shop: what it is, what's included (the catalog item's Details, edited at
   /shop/admin), the other options of its category to compare, and the same cart as /shop.
   /shop/success, /shop/cancel and /shop/admin are literal routes, so they win over {Sku}. *@

<PageTitle>@(_item is null ? L["shop.notfound"] : $"{_item.Name} — MapleKiosk")</PageTitle>
@if (_item is not null)
{
    <HeadContent>
        <meta name="description" content="@(_item.Description ?? _item.Name)" />
        <meta property="og:title" content="@_item.Name — MapleKiosk" />
        <meta property="og:description" content="@(_item.Description ?? _item.Name)" />
        <meta property="og:url" content="@Nav.Uri" />
        @if (!string.IsNullOrWhiteSpace(_item.ImageUrl))
        {
            <meta property="og:image" content="@(new Uri(new Uri(Nav.BaseUri), _item.ImageUrl))" />
        }
    </HeadContent>
}

<NavBar />

<main class="sh">
    <div class="container sh__grid">

        <div class="sh__main">
            <a class="sh-back" href="@ShopPath"><span aria-hidden="true">←</span> @L["shop.back"]</a>

            @if (_item is null || _category is null)
            {
                <p class="sh__empty">@L["shop.notfound"]</p>
            }
            else
            {
                <article class="sh-detail">
                    <p class="sh-cat__title">@_category.Name</p>
                    @if (!string.IsNullOrWhiteSpace(_item.ImageUrl))
                    {
                        <img class="sh-detail__img" src="@_item.ImageUrl" alt="@_item.Name" />
                    }
                    <h1 class="sh-detail__name">@_item.Name</h1>
                    @if (_item.Recommended || HasTrial(_item))
                    {
                        <p class="sh-detail__tags">
                            @if (_item.Recommended) { <span class="sh-tag">@L["pr.rec"]</span> }
                            @if (HasTrial(_item)) { <span class="sh-tag sh-tag--trial">@string.Format(L["shop.trial"], _item.TrialDays)</span> }
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_item.Description))
                    {
                        <p class="sh-detail__lead">@_item.Description</p>
                    }

                    <div class="sh-buy">
                        <div>
                            <p class="sh-buy__price">@Money(_item.Price)<small>@Per(_item)</small></p>
                            <p class="sh-buy__billed">@Billed(_item)</p>
                        </div>
                        <ShopAdd Culture="@L.Culture" Sku="@_item.Sku" Name="@_item.Name" Price="@_item.Price"
                                 BillingInterval="@_item.BillingInterval" TrialDays="@_item.TrialDays"
                                 Group="@_category.Key" PickOne="@_category.PickOne" />
                    </div>
                    @if (_category.PickOne && _siblings.Count > 0)
                    {
                        <p class="sh-detail__note">@string.Format(L["shop.swap"], _category.Name)</p>
                    }

                    @if (Points(_item) is { Count: > 0 } points)
                    {
                        <section class="sh-detail__inc" aria-labelledby="sh-inc">
                            <h2 class="sh-detail__h2" id="sh-inc">@L["shop.included"]</h2>
                            <ul class="sh-checks">
                                @foreach (var pt in points) { <li>@pt</li> }
                            </ul>
                        </section>
                    }
                </article>

                @if (_siblings.Count > 0)
                {
                    <section class="sh-cat" aria-labelledby="sh-cmp">
                        <h2 class="sh-cat__title" id="sh-cmp">@string.Format(L["shop.compare"], _category.Name)</h2>
                        <ul class="sh-list">
                            @foreach (var i in _siblings)
                            {
                                <li class="sh-item">
                                    <a class="sh-item__info" href="@ItemPath(i)">
                                        <h3 class="sh-item__name">@i.Name <span class="sh-item__go" aria-hidden="true">›</span></h3>
                                        @if (!string.IsNullOrWhiteSpace(i.Description))
                                        {
                                            <p class="sh-item__desc">@i.Description</p>
                                        }
                                    </a>
                                    <p class="sh-item__price">@Money(i.Price)<small>@Per(i)</small></p>
                                    <ShopAdd Culture="@L.Culture" Sku="@i.Sku" Name="@i.Name" Price="@i.Price"
                                             BillingInterval="@i.BillingInterval" TrialDays="@i.TrialDays"
                                             Group="@_category.Key" PickOne="@_category.PickOne" />
                                </li>
                            }
                        </ul>
                    </section>
                }
            }
        </div>

        <ShopCart Culture="@L.Culture" />
    </div>
</main>

<Footer />

@code {
    [Parameter] public string Sku { get; set; } = "";

    private AppProduct? _item;
    private CatalogCategory? _category;
    private IReadOnlyList<AppProduct> _siblings = [];

    protected override async Task OnParametersSetAsync()
    {
        var seg = new Uri(Nav.Uri).AbsolutePath.Trim('/').Split('/').FirstOrDefault() ?? "";
        L.SetCulture(seg);

        _item = null; _category = null; _siblings = [];
        foreach (var (cat, items) in await Catalog.GetShopAsync())
        {
            if (items.FirstOrDefault(i => string.Equals(i.Sku, Sku, StringComparison.OrdinalIgnoreCase)) is not { } hit) continue;
            (_item, _category) = (hit, cat);
            _siblings = items.Where(i => i.Sku != hit.Sku).ToList();
            break;
        }
    }

    private string Prefix => L.Culture == "en" ? "" : L.Culture + "/";
    private string ShopPath => $"{Prefix}shop";
    private string ItemPath(AppProduct i) => $"{Prefix}shop/{Uri.EscapeDataString(i.Sku)}";

    private static bool HasTrial(AppProduct i) => i.TrialDays > 0 && BillingIntervals.IsRecurring(i.BillingInterval);

    // The Details lines; an item without them falls back to its features.
    private static List<string> Points(AppProduct i)
    {
        var lines = (i.Details ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        return lines.Count > 0 ? lines : i.Features;
    }

    private string Per(AppProduct i) => i.BillingInterval switch
    {
        BillingIntervals.Monthly => " " + L["pr.month"],
        BillingIntervals.Yearly => " " + L["pr.year"],
        _ => "",
    };

    private string Billed(AppProduct i) => i.BillingInterval switch
    {
        BillingIntervals.Monthly => L["shop.billed.month"],
        BillingIntervals.Yearly => L["shop.billed.year"],
        _ => L["shop.billed.once"],
    };

    private string Money(decimal d) => ShopMoney.Format(d, L.Culture);
}

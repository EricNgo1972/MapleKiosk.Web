@page "/coffee"
@page "/fr/coffee"
@page "/vi/coffee"
@page "/ru/coffee"
@layout Layout.CoffeeLayout
@inject LocalizationService L
@inject NavigationManager Nav

<PageTitle>@L["cof.meta.title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["cof.meta.desc"]" />
    <meta property="og:title" content="@L["cof.meta.title"]" />
    <meta property="og:description" content="@L["cof.meta.desc"]" />
    <meta property="og:url" content="@Nav.Uri" />
    <meta property="og:image" content="@(Nav.BaseUri)img/coffee/hero.jpg" />
</HeadContent>

<NavBar />

<main class="gp">

    <!-- ===================== HERO ===================== -->
    <section class="gp-hero" id="top">
        <Breadcrumbs Current="@L["ind.coffee"]" />
        <div class="container gp-hero__grid">
            <div>
                <p class="gp-hero__product">MapleCoffee</p>
                <h1 class="gp-hero__title">@L["cof.hero.title"]</h1>
                <p class="gp-hero__sub">@L["cof.hero.sub"]</p>
                <div class="gp-hero__ctas">
                    <a class="btn btn-primary" href="@TestDrive" target="_blank" rel="noopener">@L["cof.cta.trial"]</a>
                    <button type="button" class="btn gp-btn-ghost" data-video="@Overview.Id">
                        @L["cof.hero.watch"] <span>@Overview.Length</span>
                    </button>
                </div>
                <p class="gp-hero__note">@L["cof.hero.note"]</p>
                <a class="hp-link spa-price" href="@PricingPath">@L["spa.cta.pricing"] <span aria-hidden="true">→</span></a>
            </div>
            <button type="button" class="gp-shot gp-shot--hero" data-video="@Overview.Id"
                    aria-label="@($"{L["cof.watch"]}: {L["cof.hero.watch"]} ({Overview.Length})")">
                <img src="img/coffee/hero.jpg" alt="@L["cof.hero.alt"]" width="1280" height="720" />
                <span class="hp-play" aria-hidden="true"></span>
            </button>
        </div>
    </section>

    <!-- ===================== WHAT IT TAKES OFF YOUR HANDS ===================== -->
    <section class="gp-day">
        <div class="container">
            <h2 class="gp-h2">@L["cof.day.title"]</h2>
            <p class="gp-lead">@L["cof.day.sub"]</p>

            <ol class="gp-steps">
                @for (var i = 0; i < _films.Length; i++)
                {
                    var f = _films[i];
                    <li class="gp-step @(i % 2 == 1 ? "gp-step--flip" : "")">
                        <button type="button" class="gp-shot gp-shot--film" data-video="@f.Id"
                                aria-label="@($"{L["cof.watch"]}: {L[$"cof.s.{f.Key}.t"]} ({f.Length})")">
                            <img src="img/coffee/@(f.Key).jpg" alt="@L[$"cof.s.{f.Key}.alt"]" loading="lazy" width="1280" height="720" />
                            <span class="hp-play" aria-hidden="true"></span>
                        </button>
                        <div class="gp-step__body">
                            <span class="gp-step__num">@(i + 1)</span>
                            <h3>@L[$"cof.s.{f.Key}.t"]</h3>
                            <p>@L[$"cof.s.{f.Key}.d"]</p>
                            <button type="button" class="hp-link" data-video="@f.Id">
                                @L["cof.watch"] <span>@f.Length</span>
                            </button>
                            @if (f.HowTo is not null)
                            {
                                <br />
                                <button type="button" class="hp-link" data-video="@f.HowTo.Id">
                                    @L[$"cof.s.{f.Key}.howto"] <span>@f.HowTo.Length</span>
                                </button>
                            }
                        </div>
                    </li>
                }
            </ol>
        </div>
    </section>

    <!-- ===================== CLOSE ===================== -->
    <section class="gp-end">
        <div class="container">
            <h2 class="gp-h2">@L["cof.end.title"]</h2>
            <div class="hp-end__actions">
                <a class="btn btn-primary" href="javascript:void(0)" data-open-trial>@L["nav.cta"]</a>
                <a class="btn gp-btn-ghost" href="@TestDrive" target="_blank" rel="noopener">@L["cof.cta.trial"]</a>
                <a class="btn gp-btn-ghost" href="@PricingPath">@L["spa.cta.pricing"]</a>
                <span>@L["hp.end.or"] <a data-user="sales" data-domain="maplekiosk.ca">sales [at] maplekiosk.ca</a></span>
            </div>
        </div>
    </section>

</main>

<TrialForm Culture="@L.Culture" />
<Footer />
<MobileCta Href="@TestDrive" Label="@L["cof.cta.trial"]" />

@code {
    private const string TestDrive = "https://coffee.maplekiosk.ca";

    // The "Maple Coffee" films on the Maple Kiosk YouTube channel (playlist PLcyXbOgtlNhA, English
    // only). HowTo = a longer set-up walkthrough shown under the step it belongs to.
    private record Film(string Id, string Length);
    private record FilmInfo(string Key, string Id, string Length, Film? HowTo = null);

    private static readonly Film Overview = new("dwXwTZY2cGA", "0:38");

    // Ordered as a café day: the rush, the second till, checkout, regulars, then payday and the menu.
    private readonly FilmInfo[] _films =
    {
        new("rush",     "DOrVkwVhBVQ", "1:08"),
        new("kiosk",    "Zxsj4OQ8CCY", "1:08"),
        new("voice",    "G5uLNWY26ds", "1:16"),
        new("checkout", "-MW2ir_vs2o", "1:14"),
        new("loyalty",  "f8ZeusLsGAM", "1:13"),
        new("tips",     "VFIstuRr1d0", "1:06", HowTo: new("sQG1-vK-Zn4", "2:44")),
        new("menu",     "r-MfbErVfjA", "1:05"),
    };

    protected override void OnInitialized()
    {
        // Localized routes: /coffee (en), /fr/coffee, /vi/coffee, /ru/coffee.
        var seg = new Uri(Nav.Uri).AbsolutePath.Trim('/').Split('/').FirstOrDefault() ?? "";
        L.SetCulture(seg);
    }

    private string PricingPath => L.Culture == "en" ? "/coffee/pricing" : $"/{L.Culture}/coffee/pricing";
}

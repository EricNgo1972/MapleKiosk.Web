@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="bg-fx" aria-hidden="true">
    <div class="bg-fx__blob bg-fx__blob--a"></div>
    <div class="bg-fx__blob bg-fx__blob--b"></div>
    <div class="bg-fx__blob bg-fx__blob--c"></div>
</div>

@Body

@* Gated in the static-SSR layout so marketing pages never open the widget's circuit. *@
@if (OnShopPage)
{
    <ShopWidget />
}

<div id="blazor-error-ui" style="display:none;">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool OnShopPage
    {
        get
        {
            var rel = Nav.ToBaseRelativePath(Nav.Uri);
            return rel.Equals("shop", StringComparison.OrdinalIgnoreCase)
                || rel.StartsWith("shop/", StringComparison.OrdinalIgnoreCase)
                || rel.StartsWith("shop?", StringComparison.OrdinalIgnoreCase)
                || rel.StartsWith("shop#", StringComparison.OrdinalIgnoreCase);
        }
    }
}
